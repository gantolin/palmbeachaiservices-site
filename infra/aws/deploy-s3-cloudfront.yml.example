# NOT ACTIVE. Moved out of .github/workflows when hosting switched to GitHub Pages (see .github/workflows/pages.yml).
# Kept as a reference in case the site ever moves to S3 + CloudFront. To use it, copy it back to .github/workflows/.

# Build the static site and deploy it to S3 + CloudFront using GitHub OIDC (no long-lived AWS keys).
#
# Required repository VARIABLES (Settings → Secrets and variables → Actions → Variables):
#   AWS_ROLE_ARN                 arn:aws:iam::<account-id>:role/pbai-site-deploy
#   AWS_REGION                   us-east-1 (region of the S3 bucket)
#   S3_BUCKET                    palmbeachaiservices.com-site (bucket name only, no s3://)
#   CLOUDFRONT_DISTRIBUTION_ID   E123ABC456XYZ
#   PUBLIC_LEAD_ENDPOINT         https://<lambda-function-url>/   (optional until the Lambda exists)
#
# Until AWS_ROLE_ARN is set, pushes only build (the deploy job is skipped), so nothing fails.
name: Build and deploy

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    env:
      PUBLIC_LEAD_ENDPOINT: ${{ vars.PUBLIC_LEAD_ENDPOINT }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
      - run: npm ci
      - name: Type-check + build (astro check && astro build)
        run: npm run build
      - uses: actions/upload-artifact@v4
        with:
          name: dist
          path: dist
          retention-days: 7

  deploy:
    needs: build
    if: github.event_name != 'pull_request' && github.ref == 'refs/heads/main' && vars.AWS_ROLE_ARN != ''
    runs-on: ubuntu-latest
    environment: production
    permissions:
      id-token: write # required for GitHub OIDC → AWS STS
      contents: read
    concurrency:
      group: deploy-production
      cancel-in-progress: false
    steps:
      - uses: actions/download-artifact@v4
        with:
          name: dist
          path: dist

      - name: Configure AWS credentials (OIDC)
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ vars.AWS_ROLE_ARN }}
          aws-region: ${{ vars.AWS_REGION || 'us-east-1' }}

      - name: Upload hashed assets (cache 1 year, immutable)
        run: |
          aws s3 sync dist/_astro "s3://${{ vars.S3_BUCKET }}/_astro" \
            --delete --cache-control "public,max-age=31536000,immutable"

      - name: Upload HTML + everything else (always revalidate)
        run: |
          aws s3 sync dist "s3://${{ vars.S3_BUCKET }}" \
            --delete --exclude "_astro/*" \
            --cache-control "public,max-age=0,s-maxage=300,must-revalidate"

      - name: Invalidate CloudFront
        run: |
          aws cloudfront create-invalidation \
            --distribution-id "${{ vars.CLOUDFRONT_DISTRIBUTION_ID }}" \
            --paths "/*"
