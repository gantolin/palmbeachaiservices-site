# Copy to .env for local dev. In GitHub Actions this is the PUBLIC_WEB3FORMS_KEY repo variable
# (Settings > Secrets and variables > Actions > Variables).
# Web3Forms access key tied to Gene@palmbeachaiservices.com. Public by design: it can only email that inbox.
# Leave empty and the teardown form skips sending and goes straight to booking.
PUBLIC_WEB3FORMS_KEY=
