---
// Vanilla-JS calculator. Numbers are the visitor's own inputs; no industry stats are claimed.
import Icon from '../ui/Icon.astro';
import { CTA } from '@/config/site';
const fields = [
  { id: 'calls', label: 'Missed calls per week', min: 1, max: 30, step: 1, value: 4, prefix: '', suffix: '' },
  { id: 'job', label: 'Average job value', min: 100, max: 15000, step: 50, value: 1500, prefix: '$', suffix: '' },
  { id: 'close', label: 'How many you would normally close', min: 5, max: 90, step: 5, value: 30, prefix: '', suffix: '%' },
];
const initMonth = fields[0].value * 4.33 * (fields[2].value / 100) * fields[1].value;
const money = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
const initJobs = Math.max(1, Math.round(fields[0].value * 4.33 * (fields[2].value / 100)));
---
<div class="calc card-dark relative overflow-hidden p-6 sm:p-8 lg:p-10" data-calc>
  <div class="absolute inset-0 pointer-events-none opacity-60" style="background: radial-gradient(70% 60% at 100% 0%, rgba(53,94,59,.55), transparent 70%)"></div>
  <div class="relative">
    <div class="flex items-center justify-between gap-4">
      <div class="eyebrow">Missed-call cost calculator</div>
      <Icon name="phone-missed" size={20} class="text-gold-300" />
    </div>
    <form class="mt-7 space-y-7" onsubmit="return false" aria-label="Missed-call cost calculator">
      {fields.map((f) => (
        <div>
          <div class="flex items-baseline justify-between gap-4">
            <label for={`calc-${f.id}`} class="text-[15px] text-mist-200">{f.label}</label>
            <output for={`calc-${f.id}`} class="font-mono text-[15px] text-gold-300 tabular" data-out={f.id}>{f.prefix}{f.value.toLocaleString('en-US')}{f.suffix}</output>
          </div>
          <input id={`calc-${f.id}`} name={f.id} type="range" min={f.min} max={f.max} step={f.step} value={f.value}
            data-prefix={f.prefix} data-suffix={f.suffix} class="range mt-3 w-full" />
        </div>
      ))}
    </form>
    <div class="mt-9 grid grid-cols-2 gap-3">
      <div class="rounded-2xl border border-white/10 bg-evergreen-950/60 p-5">
        <div class="font-mono text-[11px] uppercase tracking-[0.1em] text-mist-400">Lost per month</div>
        <div class="mt-2 font-display text-[clamp(1.9rem,4vw,2.6rem)] font-[600] tracking-tight text-gold-500 tabular" data-result="month">{money(initMonth)}</div>
      </div>
      <div class="rounded-2xl border border-white/10 bg-evergreen-950/60 p-5">
        <div class="font-mono text-[11px] uppercase tracking-[0.1em] text-mist-400">Lost per year</div>
        <div class="mt-2 font-display text-[clamp(1.9rem,4vw,2.6rem)] font-[600] tracking-tight text-mist-200 tabular" data-result="year">{money(initMonth * 12)}</div>
      </div>
    </div>
    <p class="mt-5 text-[13.5px] text-mist-400" data-result="sentence">That is about {initJobs} jobs a month walking to whoever calls back first.</p>
    <p class="mt-2 text-[12.5px] text-mist-400/80">Estimate only, based on your numbers: missed calls × 4.33 weeks × close rate × job value.</p>
    <a href={CTA.primary.href} class="btn btn-primary mt-7 w-full sm:w-auto">Stop the leak: get my free teardown <Icon name="arrow-right" size={18} /></a>
  </div>
</div>

<style>
  .range { -webkit-appearance: none; appearance: none; height: 28px; background: transparent; cursor: pointer; --p: 50%; }
  .range::-webkit-slider-runnable-track { height: 6px; border-radius: 999px; background: linear-gradient(90deg, #c9a227 var(--p), rgba(233,228,214,.14) var(--p)); }
  .range::-moz-range-track { height: 6px; border-radius: 999px; background: rgba(233,228,214,.14); }
  .range::-moz-range-progress { height: 6px; border-radius: 999px; background: #c9a227; }
  .range::-webkit-slider-thumb { -webkit-appearance: none; margin-top: -9px; width: 24px; height: 24px; border-radius: 50%; background: #faf8f2; border: 5px solid #c9a227; box-shadow: 0 2px 10px rgba(0,0,0,.4); transition: transform 150ms; }
  .range::-moz-range-thumb { width: 16px; height: 16px; border-radius: 50%; background: #faf8f2; border: 5px solid #c9a227; }
  .range:active::-webkit-slider-thumb { transform: scale(1.12); }
  .range:focus-visible { outline: 2px solid #c9a227; outline-offset: 4px; }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-calc]');
  if (root) {
    const $ = (s: string) => root.querySelector<HTMLElement>(s)!;
    const inputs = Array.from(root.querySelectorAll<HTMLInputElement>('input[type=range]'));
    const money = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
    const update = () => {
      const v: Record<string, number> = {};
      inputs.forEach((i) => {
        v[i.name] = Number(i.value);
        const pct = ((Number(i.value) - Number(i.min)) / (Number(i.max) - Number(i.min))) * 100;
        i.style.setProperty('--p', pct + '%');
        $(`[data-out="${i.name}"]`).textContent = (i.dataset.prefix ?? '') + Number(i.value).toLocaleString('en-US') + (i.dataset.suffix ?? '');
      });
      const jobsPerMonth = v.calls * 4.33 * (v.close / 100);
      const month = jobsPerMonth * v.job;
      $('[data-result="month"]').textContent = money(month);
      $('[data-result="year"]').textContent = money(month * 12);
      const jobs = Math.max(1, Math.round(jobsPerMonth));
      $('[data-result="sentence"]').textContent = `That is about ${jobs} job${jobs === 1 ? '' : 's'} a month walking to whoever calls back first.`;
    };
    inputs.forEach((i) => i.addEventListener('input', update));
    update();
  }
</script>
