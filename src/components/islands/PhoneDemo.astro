---
import Icon from '../ui/Icon.astro';
// Pure HTML/CSS + ~1KB of JS. All messages render server-side (visible without JS);
// JS replays them in sequence every ~12s while on screen. Reduced motion = static thread.
const thread = [
  { kind: 'system', icon: 'phone-missed', text: 'Missed call · (561) 555-0142 · 2:14 PM' },
  { kind: 'out', text: 'Hi! Sorry we missed your call. This is {Your Company}. What can we help you with today?', meta: 'Auto-text · sent in seconds' },
  { kind: 'in', text: 'Need a quote for a paver patio. Any chance this week?' },
  { kind: 'out', text: 'Absolutely. We can come out Tuesday at 9am or Thursday at 2pm. Which works best?' },
  { kind: 'in', text: 'Tuesday at 9 works 👍' },
  { kind: 'system', icon: 'calendar-check', text: 'Booked · Tue 9:00 AM · added to calendar', good: true },
  { kind: 'out', text: 'Thanks for choosing us! Would you mind leaving a quick Google review? ⭐', meta: 'Review request · after the job' },
];
const fill = (t: string) => t.replace('{Your Company}', '<span class="merge">Your Company</span>');
---
<div class="phone-wrap relative mx-auto xl:mx-0 w-full max-w-[340px]" data-phone-demo>
  <div class="phone relative rounded-[46px] p-[10px] bg-[#0b150e] border border-white/10 shadow-[0_40px_80px_-30px_rgba(0,0,0,.8),0_0_0_1px_rgba(230,205,131,.06)_inset]">
    <div class="screen relative overflow-hidden rounded-[37px] bg-[#f6f4ee] h-[560px] flex flex-col">
      <div class="notch absolute left-1/2 -translate-x-1/2 top-2.5 h-[26px] w-[96px] rounded-full bg-[#0b150e] z-10"></div>
      <div class="flex items-center justify-between px-7 pt-3.5 text-[11px] font-semibold text-ink-900 tabular"><span>2:14</span><span class="flex gap-1 items-center"><span class="w-4 h-2 rounded-[2px] border border-ink-900/70"></span></span></div>
      <div class="flex flex-col items-center pt-5 pb-3 border-b border-stone-300/70 bg-[#f6f4ee]/95">
        <div class="size-10 rounded-full bg-evergreen-100 text-evergreen-700 flex items-center justify-center"><Icon name="users" size={18} /></div>
        <div class="mt-1.5 text-[12.5px] font-semibold text-ink-900">New lead</div>
        <div class="text-[10.5px] text-ink-600">Text message</div>
      </div>
      <ol class="thread flex-1 flex flex-col justify-end gap-2 px-3.5 pb-4 pt-3 overflow-hidden" aria-label="Example missed-call text-back conversation">
        {thread.map((m, i) => (
          <li class={`msg msg-${m.kind}`} data-i={i}>
            {m.kind === 'system' ? (
              <div class={`sys ${m.good ? 'sys-good' : ''}`}><Icon name={m.icon!} size={13} stroke={2} />{m.text}</div>
            ) : (
              <>
                <div class="bubble" set:html={fill(m.text)} />
                {m.meta && <div class="meta">{m.meta}</div>}
              </>
            )}
          </li>
        ))}
        <li class="msg msg-in typing" aria-hidden="true"><div class="bubble"><span></span><span></span><span></span></div></li>
      </ol>
    </div>
  </div>
  <div class="absolute -top-3 left-1/2 -translate-x-1/2 chip bg-evergreen-950 border border-gold-300/30 text-gold-300 font-mono text-[10.5px] uppercase tracking-[0.12em] whitespace-nowrap shadow-lg">
    <span class="size-1.5 rounded-full bg-gold-500"></span> Demo · missed-call text-back
  </div>
</div>

<style>
  .thread { font-size: 13px; line-height: 1.38; }
  .msg { display: flex; flex-direction: column; max-width: 84%; }
  .msg-out { align-self: flex-end; align-items: flex-end; }
  .msg-in { align-self: flex-start; }
  .msg-system { align-self: center; max-width: 100%; }
  .bubble { padding: 8px 12px; border-radius: 18px; }
  .msg-out .bubble { background: #355e3b; color: #faf8f2; border-bottom-right-radius: 6px; }
  .msg-in .bubble { background: #e6e2d6; color: #1c2420; border-bottom-left-radius: 6px; }
  .meta { font-size: 10px; color: #5b665f; margin-top: 3px; font-family: var(--font-mono); letter-spacing: .02em; }
  .sys { display: inline-flex; align-items: center; gap: 6px; font-size: 10.5px; font-weight: 600; color: #8a2d1f; background: #f7e3dc; border-radius: 999px; padding: 4px 10px; }
  .sys-good { color: #1b3420; background: #ddeadf; }
  .bubble :global(.merge) { background: rgba(230, 205, 131, .28); border: 1px dashed rgba(230, 205, 131, .7); border-radius: 5px; padding: 0 4px; white-space: nowrap; }
  .typing { display: none; }
  .typing .bubble { display: flex; gap: 4px; padding: 12px 14px; }
  .typing span { width: 6px; height: 6px; border-radius: 50%; background: #8a948d; animation: dot 1s infinite ease-in-out; }
  .typing span:nth-child(2) { animation-delay: .15s; } .typing span:nth-child(3) { animation-delay: .3s; }
  @keyframes dot { 0%, 80%, 100% { opacity: .35; transform: translateY(0) } 40% { opacity: 1; transform: translateY(-2px) } }

  /* Animated mode (enabled by JS) */
  [data-phone-demo].is-live .msg:not(.typing) { display: none; }
  [data-phone-demo].is-live .msg.shown { display: flex; animation: pop 380ms cubic-bezier(.2,.7,.2,1) both; }
  [data-phone-demo].is-live .typing.shown { display: flex; }
  @keyframes pop { from { opacity: 0; transform: translateY(8px) scale(.98) } to { opacity: 1; transform: none } }
  @media (max-width: 480px) { .screen { height: 520px !important; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-phone-demo]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (root && !reduce) {
    const msgs = Array.from(root.querySelectorAll<HTMLElement>('.msg:not(.typing)'));
    const typing = root.querySelector<HTMLElement>('.typing');
    let timers: number[] = [];
    let visible = false;
    const clear = () => { timers.forEach(clearTimeout); timers = []; };
    const play = () => {
      clear();
      root.classList.add('is-live');
      msgs.forEach((m) => m.classList.remove('shown'));
      typing?.classList.remove('shown');
      let t = 400;
      msgs.forEach((m, i) => {
        const isIn = m.classList.contains('msg-in');
        if (isIn && typing) {
          timers.push(window.setTimeout(() => { typing.classList.add('shown'); typing.parentElement?.appendChild(typing); }, t));
          t += 900;
        }
        timers.push(window.setTimeout(() => { typing?.classList.remove('shown'); m.classList.add('shown'); }, t));
        t += i === 0 ? 900 : 1300;
      });
      timers.push(window.setTimeout(() => visible && play(), t + 3200));
    };
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) play(); else clear();
    }, { threshold: 0.25 }).observe(root);
  }
</script>
