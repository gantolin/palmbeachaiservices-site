---
import Icon from '../ui/Icon.astro';
// Pure HTML/CSS + ~1KB of JS. All messages render server-side (visible without JS);
// JS replays them in sequence every ~12s while on screen. Reduced motion = static thread.
// Styled like a real phone's text thread: timestamps and small status lines, no labels or badges.
const thread = [
  { kind: 'time', text: 'Today 2:14 PM' },
  { kind: 'missed', text: 'Missed call' },
  { kind: 'out', text: 'Hi, sorry we missed your call! This is Mike. What can I help you with?' },
  { kind: 'in', text: 'Need a quote for a paver patio. Any chance this week?' },
  { kind: 'out', text: 'Yes! We can come out Tuesday at 9 or Thursday at 2. Which is better for you?' },
  { kind: 'in', text: 'Tuesday at 9 works 👍' },
  { kind: 'booked', text: 'Added to calendar: Tue 9:00 AM' },
  { kind: 'time', text: 'Tuesday 4:32 PM' },
  { kind: 'out', text: 'Thanks again for having us out! If you have a minute, a quick Google review would really help us.' },
];
const isBubble = (k: string) => k === 'in' || k === 'out';
---
<div class="phone-wrap relative mx-auto xl:mx-0 w-full max-w-[340px]" data-phone-demo>
  <div class="phone-tilt" data-tilt="7">
  <div class="phone relative rounded-[46px] p-[10px] bg-[#020a15] border border-white/10 shadow-[0_40px_80px_-30px_rgba(0,0,0,.8),0_0_0_1px_rgba(230,205,131,.06)_inset]">
    <div class="screen relative overflow-hidden rounded-[37px] bg-white h-[560px] flex flex-col">
      <div class="notch absolute left-1/2 -translate-x-1/2 top-2.5 h-[26px] w-[96px] rounded-full bg-[#020a15] z-10"></div>
      <div class="status flex items-center justify-between px-7 pt-3.5 text-[12px] font-semibold text-black tabular">
        <span>2:14</span>
        <span class="flex gap-1.5 items-center" aria-hidden="true">
          <span class="bars"><i></i><i></i><i></i><i></i></span>
          <span class="battery"><i></i></span>
        </span>
      </div>
      <div class="contact flex flex-col items-center pt-4 pb-2.5">
        <div class="avatar" aria-hidden="true"><svg viewBox="0 0 42 42" width="42" height="42"><circle cx="21" cy="16" r="7" fill="#fff" /><path d="M7 37c1.8-7.5 7.4-11 14-11s12.2 3.5 14 11" fill="#fff" /></svg></div>
        <div class="mt-1 text-[11.5px] text-black">(561) 555-0142 <span class="text-[#8e8e93]">&rsaquo;</span></div>
      </div>
      <div class="incoming" aria-hidden="true">
        <div class="ring"><Icon name="phone" size={22} stroke={2} /></div>
        <div class="mt-3 text-[13px] font-semibold text-black">Incoming call</div>
        <div class="text-[11px] text-[#8e8e93] tabular">(561) 555-0142</div>
      </div>
      <ol class="thread flex-1 flex flex-col justify-end gap-[5px] px-3 pb-4 pt-2 overflow-hidden" aria-label="Example: what a customer sees when you miss their call">
        {thread.map((m, i) => (
          <li class={`msg msg-${m.kind}`} data-i={i}>
            {isBubble(m.kind) ? (
              <div class="bubble">{m.text}</div>
            ) : m.kind === 'time' ? (
              <div class="stamp">{m.text}</div>
            ) : (
              <div class={`note note-${m.kind}`}><Icon name={m.kind === 'missed' ? 'phone-missed' : 'calendar-check'} size={12} stroke={2} />{m.text}</div>
            )}
          </li>
        ))}
        <li class="msg msg-in typing typing-in" aria-hidden="true"><div class="bubble"><span></span><span></span><span></span></div></li>
        <li class="msg msg-out typing typing-out" aria-hidden="true"><div class="bubble"><span></span><span></span><span></span></div></li>
      </ol>
    </div>
    <div class="glare" aria-hidden="true"></div>
  </div>
  </div>
  <p class="mt-5 text-center text-[13.5px] text-mist-400">What a customer sees when you miss their call.</p>
</div>

<style>
  .screen { font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Roboto, sans-serif; }
  .bars { display: inline-flex; align-items: flex-end; gap: 1.5px; height: 9px; }
  .bars i { width: 2.5px; background: #000; border-radius: 1px; }
  .bars i:nth-child(1) { height: 3px; } .bars i:nth-child(2) { height: 5px; } .bars i:nth-child(3) { height: 7px; } .bars i:nth-child(4) { height: 9px; }
  .battery { position: relative; width: 20px; height: 9.5px; border: 1px solid rgba(0,0,0,.45); border-radius: 3px; padding: 1px; }
  .battery i { display: block; width: 75%; height: 100%; background: #000; border-radius: 1.5px; }
  .avatar { width: 42px; height: 42px; border-radius: 50%; overflow: hidden;
    background: linear-gradient(180deg, #a5abb8, #858b98); }
  .thread { font-size: 13px; line-height: 1.35; }
  .msg { display: flex; flex-direction: column; max-width: 78%; }
  .msg-out { align-self: flex-end; align-items: flex-end; }
  .msg-in { align-self: flex-start; }
  .msg-time, .msg-missed, .msg-booked { align-self: center; max-width: 100%; margin: 4px 0 2px; }
  .bubble { padding: 7px 12px; border-radius: 18px; }
  .msg-out .bubble { background: #0b62c4; color: #fff; }
  .msg-in .bubble { background: #e9e9eb; color: #000; }
  .stamp { font-size: 10.5px; color: #8e8e93; font-weight: 500; }
  .note { display: inline-flex; align-items: center; gap: 5px; font-size: 10.5px; color: #8e8e93; }
  .note-missed :global(svg) { color: #e5484d; }
  .note-booked :global(svg) { color: #1f8a4c; }
  .typing { display: none; }
  .typing-out span { background: rgba(255,255,255,.75) !important; }
  .incoming { display: none; }
  .glare { position: absolute; inset: 0; border-radius: 46px; pointer-events: none; opacity: 0; transition: opacity 400ms;
    background: radial-gradient(420px circle at var(--gx, 50%) var(--gy, 30%), rgba(255,255,255,.14), transparent 60%); }
  :global(.is-tilting) .glare { opacity: 1; }
  .typing .bubble { display: flex; gap: 4px; padding: 11px 13px; }
  .typing span { width: 6px; height: 6px; border-radius: 50%; background: #8e8e93; animation: dot 1s infinite ease-in-out; }
  .typing span:nth-child(2) { animation-delay: .15s; } .typing span:nth-child(3) { animation-delay: .3s; }
  @keyframes dot { 0%, 80%, 100% { opacity: .35; transform: translateY(0) } 40% { opacity: 1; transform: translateY(-2px) } }

  /* Animated mode (enabled by JS) */
  [data-phone-demo].is-live .msg:not(.typing) { display: none; }
  [data-phone-demo].is-live .msg.shown { display: flex; animation: pop 380ms cubic-bezier(.2,.7,.2,1) both; }
  [data-phone-demo].is-live .typing.shown { display: flex; animation: pop 260ms cubic-bezier(.2,.7,.2,1) both; }
  [data-phone-demo].is-live .incoming.shown { display: flex; flex-direction: column; align-items: center; position: absolute; inset: 150px 0 auto; animation: pop 380ms cubic-bezier(.2,.7,.2,1) both; }
  .ring { position: relative; width: 58px; height: 58px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #1f8a4c; color: #fff; }
  .ring::before { content: ''; position: absolute; inset: 0; border-radius: 50%; background: #1f8a4c; z-index: -1; animation: ring 1.1s ease-out infinite; }
  .incoming { isolation: isolate; }
  @keyframes ring { from { transform: scale(1); opacity: .5 } to { transform: scale(1.8); opacity: 0 } }
  @keyframes pop { from { opacity: 0; transform: translateY(8px) scale(.98) } to { opacity: 1; transform: none } }
  @media (max-width: 480px) { .screen { height: 520px !important; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-phone-demo]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (root && !reduce) {
    const msgs = Array.from(root.querySelectorAll<HTMLElement>('.msg:not(.typing)'));
    const typingIn = root.querySelector<HTMLElement>('.typing-in');
    const typingOut = root.querySelector<HTMLElement>('.typing-out');
    const incoming = root.querySelector<HTMLElement>('.incoming');
    const list = msgs[0]?.parentElement;
    let timers: number[] = [];
    let visible = false;
    const at = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));
    const clear = () => { timers.forEach(clearTimeout); timers = []; };
    const hideTyping = () => { typingIn?.classList.remove('shown'); typingOut?.classList.remove('shown'); };
    const play = () => {
      clear();
      root.classList.add('is-live');
      msgs.forEach((m) => m.classList.remove('shown'));
      hideTyping();
      // 1) phone rings, 2) goes to missed call, 3) conversation plays with typing dots on both sides
      incoming?.classList.add('shown');
      let t = 1900;
      at(t, () => incoming?.classList.remove('shown'));
      msgs.forEach((m) => {
        const typing = m.classList.contains('msg-in') ? typingIn : m.classList.contains('msg-out') ? typingOut : null;
        if (typing && list) {
          at(t, () => { hideTyping(); list.appendChild(typing); typing.classList.add('shown'); });
          t += m.classList.contains('msg-out') ? 1000 : 1300;
        }
        at(t, () => { hideTyping(); m.classList.add('shown'); });
        t += typing ? 900 : 350;
      });
      at(t + 3600, () => visible && play());
    };
    new IntersectionObserver(([e]) => {
      const was = visible;
      visible = e.isIntersecting;
      if (visible && !was) play(); else if (!visible) clear();
    }, { threshold: 0.25 }).observe(root);
  }
</script>
