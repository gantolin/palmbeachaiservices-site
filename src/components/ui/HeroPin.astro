---
/** Home hero art: a small map tile with a pin dropped on it and a "near me" search chip. Decorative. */
import Icon from './Icon.astro';
---
<div class="hero-pin" aria-hidden="true">
  <div class="tile">
    <svg viewBox="0 0 120 120" preserveAspectRatio="xMidYMid slice">
      <rect width="120" height="120" fill="#0b2a50" />
      <path d="M92 0C84 30 104 62 94 120H120V0Z" fill="#12467f" />
      <rect x="10" y="12" width="26" height="20" rx="4" fill="#12553f" opacity=".75" />
      <ellipse cx="58" cy="100" rx="20" ry="10" fill="#12553f" opacity=".75" />
      <g fill="none" stroke="rgba(255,255,255,.16)" stroke-width="3" stroke-linecap="round">
        <path d="M-4 40H92" /><path d="M22 -4V124" /><path d="M70 -4V124" /><path d="M-4 86L92 78" /><path d="M46 40V84" />
      </g>
      <path d="M-4 62H96" fill="none" stroke="#c9a227" stroke-width="3.5" stroke-linecap="round" opacity=".9" />
    </svg>
  </div>
  <span class="ring"></span>
  <svg class="pin" viewBox="0 0 24 24"><path d="M12 2C7.6 2 4 5.6 4 10c0 6 8 12 8 12s8-6 8-12c0-4.4-3.6-8-8-8z" fill="#ea4335" /><circle cx="12" cy="10" r="3.2" fill="#fff" /></svg>
  <span class="chip"><Icon name="search" size={12} />near me</span>
</div>

<style>
  .hero-pin { position: relative; width: 100%; aspect-ratio: 1 / 1.12; }
  .tile {
    position: absolute; left: 0; right: 0; bottom: 8%; aspect-ratio: 1; border-radius: 22%; overflow: hidden;
    border: 1px solid rgba(230, 205, 131, .45);
    box-shadow: 0 22px 40px -18px rgba(0, 0, 0, .8), 0 0 46px -14px rgba(201, 162, 39, .5);
  }
  .tile svg { width: 100%; height: 100%; display: block; }
  .pin {
    position: absolute; left: 50%; top: 50%; width: 46%; transform: translate(-50%, -100%);
    filter: drop-shadow(0 6px 6px rgba(0, 0, 0, .45));
    animation: pin-drop 700ms cubic-bezier(.3, 1.5, .5, 1) 500ms both;
  }
  .ring {
    position: absolute; left: 50%; top: 50%; width: 30%; aspect-ratio: 2.4; border-radius: 50%;
    transform: translate(-50%, -50%); border: 2px solid rgba(234, 67, 53, .8);
    animation: pin-ring 2.4s ease-out 1.2s infinite;
  }
  .chip {
    position: absolute; right: -6%; bottom: 2%; display: inline-flex; align-items: center; gap: 4px;
    padding: 5px 10px 5px 8px; border-radius: 999px; background: #fff; color: #202124; white-space: nowrap;
    font: 600 12px/1 var(--font-sans); box-shadow: 0 8px 18px -6px rgba(0, 0, 0, .6);
  }
  .chip :global(svg) { color: #4285f4; }
  @keyframes pin-drop { from { opacity: 0; transform: translate(-50%, -170%); } to { opacity: 1; transform: translate(-50%, -100%); } }
  @keyframes pin-ring { 0% { opacity: .9; transform: translate(-50%, -50%) scale(.6); } 100% { opacity: 0; transform: translate(-50%, -50%) scale(2.4); } }
  /* Gene's own PC has reduced motion on and he wants to see these, so the small effects run anyway. */
  @media (prefers-reduced-motion: reduce) {
    .pin { animation-duration: 700ms !important; }
    .ring { animation-duration: 2.4s !important; animation-iteration-count: infinite !important; }
  }
</style>
