---
import Logo from './ui/Logo.astro';
import Icon from './ui/Icon.astro';
import { SITE, NAV, telHref, mailHref } from '@/config/site';
const year = new Date().getFullYear();
const link = 'text-mist-200/85 hover:text-white';
---
<footer class="surface-dark border-t border-white/5">
  <div class="container-x pt-12 pb-28 lg:pb-10">
    <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
      <a href="/" aria-label={`${SITE.name} home`}><Logo height={48} /></a>
      <nav aria-label="Footer">
        <ul class="flex flex-wrap gap-x-7 gap-y-3 text-[15px]">
          {NAV.map((n) => <li><a class={link} href={n.href}>{n.label}</a></li>)}
          <li><a class={link} href="/#book">Book a free audit</a></li>
        </ul>
      </nav>
      <div class="flex flex-col gap-2 text-[15px]">
        <a href={telHref} class="flex items-center gap-2 text-mist-200 hover:text-gold-300"><Icon name="phone" size={16} />{SITE.phone}</a>
        <a href={mailHref} class="flex items-center gap-2 text-mist-200 hover:text-gold-300 break-all"><Icon name="mail" size={16} />{SITE.email}</a>
      </div>
    </div>
    <div class="mt-10 border-t border-white/8 pt-6 flex flex-col gap-3 md:flex-row md:items-center md:justify-between text-[13.5px] text-mist-400">
      <p>© {year} {SITE.name} · <a href={SITE.mapsUrl} target="_blank" rel="noopener" class="hover:text-white">{SITE.address.street}, {SITE.address.locality}, {SITE.address.region} {SITE.address.postalCode}</a></p>
      <ul class="flex gap-x-6">
        <li><a class="hover:text-white" href="/privacy/">Privacy</a></li>
        <li><a class="hover:text-white" href="/terms/">Terms</a></li>
      </ul>
    </div>
  </div>
</footer>
