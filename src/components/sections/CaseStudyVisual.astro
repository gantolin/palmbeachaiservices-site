---
import Icon from '../ui/Icon.astro';
interface Props { kind: 'report-time' | 'rank-ladder' | 'launch-timeline'; size?: 'sm' | 'lg' }
const { kind, size = 'sm' } = Astro.props;
const lg = size === 'lg';
---
{kind === 'report-time' && (
  <div class:list={['viz', lg && 'viz-lg']}>
    <div class="viz-head"><span>Time per inspection report</span><Icon name="clock" size={16} /></div>
    <div class="mt-5 space-y-5">
      <div>
        <div class="flex justify-between text-[13px] text-ink-600"><span>Before</span><span class="tabular font-semibold text-ink-900">45 min</span></div>
        <div class="bar mt-2 bg-[#efe3dd]"><div class="h-full w-full rounded-full bg-[#c98b78]"></div></div>
      </div>
      <div>
        <div class="flex justify-between text-[13px] text-ink-900 font-semibold"><span>After automation</span><span class="tabular">10 min</span></div>
        <div class="bar mt-2 bg-navy-100"><div class="bar-fill h-full rounded-full bg-navy-700" style="--w:22.2%"></div></div>
      </div>
    </div>
    <div class="mt-6 flex items-end justify-between border-t border-stone-300/70 pt-5">
      <div><div class="font-display text-[40px] font-[600] leading-none tracking-[-0.04em] text-navy-700 tabular"><span data-count-to="78" data-suffix="%">78%</span></div><div class="text-[12.5px] text-ink-600 mt-1.5">less time per report</div></div>
      <div class="text-right"><div class="font-display text-[24px] font-[600] leading-none tracking-tight text-ink-900 tabular">35 min</div><div class="text-[12.5px] text-ink-600 mt-1.5">saved, every report</div></div>
    </div>
  </div>
)}
{kind === 'rank-ladder' && (
  <div class:list={['viz', lg && 'viz-lg']}>
    <div class="viz-head"><span>Google · Lake Worth searches</span><Icon name="search" size={16} /></div>
    <ol class="mt-4 space-y-1.5">
      {[1, 2, 3, 4, 5].map((n) => {
        const ours = n === 2 || n === 3;
        return (
          <li class:list={['flex items-center gap-3 rounded-xl px-3 py-2 text-[13px]', ours ? 'bg-navy-700 text-white' : 'bg-white border border-stone-300/80 text-ink-600']}>
            <span class:list={['font-mono text-[11px] w-6', ours ? 'text-gold-300' : '']}>#{n}</span>
            <span class:list={['h-2 rounded-full', ours ? 'bg-white/80 w-24' : 'bg-stone-300 w-16']}></span>
            {ours ? <span class="ml-auto font-semibold text-[12.5px]">Our client</span> : <span class="ml-auto h-2 w-10 rounded-full bg-stone-300/70"></span>}
          </li>
        );
      })}
    </ol>
    <p class="mt-4 text-[12px] text-ink-600">Illustration of where the client ranks (#2 to #3) across multiple Lake Worth keywords.</p>
  </div>
)}
{kind === 'launch-timeline' && (
  <div class:list={['viz', lg && 'viz-lg']}>
    <div class="viz-head"><span>Project status</span><span class="chip bg-[#fbf3dc] text-gold-700 text-[11px] py-0.5 font-semibold">Results in progress</span></div>
    <ol class="mt-5 space-y-4">
      {[
        { t: 'Website rebuilt', d: 'Live', done: true },
        { t: 'Google Business Profile rebuilt', d: 'Live', done: true },
        { t: 'Tracking calls, reviews, rankings', d: 'Set up', done: true },
        { t: 'Ranking results', d: 'Waiting to rank', done: false },
      ].map((s) => (
        <li class="flex items-center gap-3">
          <span class:list={['size-7 rounded-full flex items-center justify-center shrink-0', s.done ? 'bg-navy-700 text-white' : 'border-2 border-dashed border-gold-500 text-gold-700']}>
            <Icon name={s.done ? 'check' : 'clock'} size={14} stroke={2.2} />
          </span>
          <span class="text-[14px] text-ink-900 font-medium">{s.t}</span>
          <span class:list={['ml-auto shrink-0 whitespace-nowrap font-mono text-[11px] uppercase tracking-wider', s.done ? 'text-navy-700' : 'text-gold-700']}>{s.d}</span>
        </li>
      ))}
    </ol>
    <p class="mt-5 text-[12px] text-ink-600">We post real numbers here when they come in. No projections.</p>
  </div>
)}

<style>
  .viz { background: linear-gradient(180deg, #fff, var(--color-cream-50)); border: 1px solid var(--color-stone-300); border-radius: 16px; padding: 20px; box-shadow: 0 10px 30px -18px rgba(7, 24, 47, .35); }
  .viz-lg { padding: 28px; }
  .viz-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; font-family: var(--font-sans); font-size: 13px; font-weight: 500; color: var(--color-ink-600); }
  .bar { height: 12px; border-radius: 999px; overflow: hidden; }
  .bar-fill { width: var(--w); }
</style>
