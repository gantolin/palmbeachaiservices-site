---
import Icon from '../ui/Icon.astro';
import { CTA } from '@/config/site';
const steps = [
  { title: 'A free call', time: 'Day 0', text: 'We look at where you show up on Google Maps and search in your town, who is ranking above you, and why. You leave the call with a list of fixes, whether you hire us or not.' },
  { title: 'Live in 14 days', time: 'Weeks 1 to 2', text: 'We build your website, clean up your Google profile, and set up review requests and lead follow-up. You see and approve everything before it goes live.' },
  { title: 'Fine-tune', time: 'Weeks 3 to 4', text: 'Once real leads come in, we adjust the text-backs, follow-ups, and review requests until they sound like you. If you want custom AI tools, this is when we talk about them.' },
  { title: 'Every month after', time: 'Ongoing', text: 'We keep building links, keep an eye on your competitors, and check in once a month on calls, reviews, and rankings. There is no contract, so you stay as long as it pays off.' },
];
---
<section class="section surface-dark relative overflow-hidden grain" id="how-it-works">
  <div class="absolute inset-0 opacity-70" style="background: radial-gradient(60% 50% at 0% 100%, rgba(30,84,148,.55), transparent 70%)" aria-hidden="true"></div>
  <div class="container-x relative">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-32">
          <div class="eyebrow">How it works</div>
          <h2 class="h2 mt-5 text-[#f4f1e8]">What the first month looks like.</h2>
          <p class="lede mt-6">You talk to the person doing the work from the first call on, and your new site is live within two weeks.</p>
          <div class="mt-9 flex flex-wrap items-center gap-5">
            <a href={CTA.primary.href} class="btn btn-primary">{CTA.primary.label}<Icon name="arrow-right" size={17} /></a>
          </div>
        </div>
      </div>
      <div class="lg:col-span-7 relative">
      <ol class="space-y-5">
        {steps.map((s, i) => (
          <li class="step card-dark relative p-6 sm:p-9 overflow-hidden" data-step={i} data-reveal style={`--d:${i * 60}ms`}>
            <div class="flex gap-5 sm:gap-6 items-start">
              <span class="numeral font-display" aria-hidden="true">{i + 1}</span>
              <div>
                <div class="font-mono text-[11.5px] uppercase tracking-[0.12em] text-gold-300">{s.time}</div>
                <h3 class="h3 mt-2 text-[#f4f1e8]"><span class="sr-only">Step {i + 1}: </span>{s.title}</h3>
                <p class="mt-3 text-mist-400 text-[15.5px] leading-relaxed">{s.text}</p>
              </div>
            </div>
          </li>
        ))}
      </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .numeral { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: 40px; height: 40px; border-radius: 50%;
    border: 1px solid rgba(230, 205, 131, 0.45); color: var(--color-gold-300); font-size: 17px; font-weight: 600; }
</style>
