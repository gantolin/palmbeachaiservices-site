---
import Icon from '../ui/Icon.astro';
import Calculator from '../islands/MissedCallCalculator.astro';
const pains = [
  { icon: 'phone-missed', title: 'Missed calls go to the next company', text: 'You\'re on a roof, under a sink, or on the road. By the time you call back, they\'ve already hired someone else.' },
  { icon: 'search', title: 'Google shows someone else first', text: 'If your Google profile is half filled out and your website is slow, the calls go to whoever shows up above you.' },
  { icon: 'receipt', title: 'Paperwork eats your nights', text: 'Quotes, invoices, reports, and follow-up texts pile up after the real work is done.' },
];
---
<section class="section surface-sand relative overflow-hidden" id="problem">
  <div class="container-x">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-16 items-start">
      <div class="lg:col-span-6" data-reveal>
        <div class="eyebrow">The problem</div>
        <h2 class="h2 mt-5">You pay to make the phone ring. Then it goes to <em class="accent">voicemail.</em></h2>
        <p class="lede mt-6">Most owners have never added up what missed calls cost them. Move the sliders and see your number.</p>
        <ul class="mt-10 space-y-6">
          {pains.map((p) => (
            <li class="flex gap-4">
              <span class="shrink-0 size-11 rounded-xl bg-white border border-stone-300 text-navy-700 flex items-center justify-center"><Icon name={p.icon} size={20} /></span>
              <div>
                <h3 class="font-display text-[18px] font-[600] tracking-tight">{p.title}</h3>
                <p class="mt-1 text-ink-600 text-[15.5px]">{p.text}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
      <div class="lg:col-span-6 lg:sticky lg:top-28 surface-dark rounded-[20px]" data-reveal style="--d:120ms">
        <Calculator />
      </div>
    </div>
  </div>
</section>
