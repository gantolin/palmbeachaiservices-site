---
import Icon from '../ui/Icon.astro';
import { industries } from '@/data/comparison';
---
<section class="section surface-cream relative" id="services">
  <div class="container-x">
    <div class="max-w-3xl" data-reveal>
      <div class="eyebrow">What we do</div>
      <h2 class="h2 mt-5">Three things. Done right. Live in <em class="accent">14 days.</em></h2>
      <p class="lede mt-6">No 40-item menu. No buzzwords. Just the three things that get a local service business more booked jobs, set up for you and running in the background.</p>
      <ol class="chain mt-8" aria-label="How the three things add up">
        {['Found on Google', 'Every call answered', 'Every lead followed up', 'Every job asks for a review', 'More booked jobs'].map((c, i, a) => (
          <li class:list={[i === a.length - 1 && 'last']}>{c}{i < a.length - 1 && <span class="arr" aria-hidden="true">→</span>}</li>
        ))}
      </ol>
    </div>

    <div class="mt-14 grid gap-5 lg:grid-cols-3">
      <!-- 1. Get found -->
      <a href="/services/local-seo-google-business-profile/" class="pillar card lift group" data-reveal>
        <div class="pillar-ui">
          <div class="rounded-xl bg-white border border-stone-300 overflow-hidden shadow-[0_8px_24px_-16px_rgba(3,14,29,.35)]">
            <div class="flex items-center gap-2 px-3 py-2.5 border-b border-stone-300/70 text-[12px] text-ink-600"><Icon name="search" size={14} />pavers near me</div>
            <div class="h-16 relative bg-[linear-gradient(135deg,#e9eef5,#dfe6f0)]">
              <svg class="absolute inset-0 w-full h-full" viewBox="0 0 300 64" preserveAspectRatio="none" aria-hidden="true"><path d="M0 40 C60 20 110 55 170 30 S260 20 300 34" stroke="#fff" stroke-width="5" fill="none" opacity=".8"/><path d="M90 0 L120 64" stroke="#fff" stroke-width="3" opacity=".7"/></svg>
              <span class="absolute left-[30%] top-3 text-navy-700"><Icon name="pin" size={22} stroke={2} /></span>
              <span class="absolute left-[62%] top-6 text-ink-600/50"><Icon name="pin" size={16} /></span>
              <span class="absolute left-[80%] top-2 text-ink-600/50"><Icon name="pin" size={16} /></span>
            </div>
            <ul class="text-[12.5px]">
              <li class="flex items-center justify-between px-3 py-2 bg-navy-50"><span class="font-semibold text-ink-900">Your business</span><span class="font-mono text-[10px] text-navy-700 uppercase tracking-wider">Top 3</span></li>
              <li class="flex items-center justify-between px-3 py-2 border-t border-stone-300/60 text-ink-600"><span>Competitor</span></li>
              <li class="flex items-center justify-between px-3 py-2 border-t border-stone-300/60 text-ink-600"><span>Competitor</span></li>
            </ul>
          </div>
        </div>
        <div class="pillar-body">
          <div class="font-mono text-[11.5px] uppercase tracking-[0.1em] text-navy-700">01 · Get found</div>
          <h3 class="h3 mt-3">Show up when your town searches.</h3>
          <p class="mt-3 text-ink-600 text-[15.5px]">A fast website and a fully optimized Google Business Profile, built around the searches that bring in jobs.</p>
          <span class="mt-5 inline-flex items-center gap-2 text-[14.5px] font-semibold text-navy-700">Websites + Local SEO <Icon name="arrow-right" size={16} class="transition-transform group-hover:translate-x-1" /></span>
        </div>
      </a>

      <!-- 2. Never miss a lead -->
      <a href="/services/ai-automation/" class="pillar card lift group" data-reveal style="--d:90ms">
        <div class="pillar-ui">
          <ol class="flow">
            <li><span class="node node-warn"><Icon name="phone-missed" size={15} /></span><span>Missed call</span><span class="t">0s</span></li>
            <li><span class="node"><Icon name="message" size={15} /></span><span>Auto-text sent</span><span class="t">seconds</span></li>
            <li><span class="node"><Icon name="inbox" size={15} /></span><span>Lead replies, you get the details</span></li>
            <li><span class="node node-good"><Icon name="calendar-check" size={15} /></span><span>Booked on your calendar</span></li>
            <li><span class="node node-gold"><Icon name="star" size={15} /></span><span>Review request after the job</span></li>
          </ol>
        </div>
        <div class="pillar-body">
          <div class="font-mono text-[11.5px] uppercase tracking-[0.1em] text-navy-700">02 · Never miss a lead</div>
          <h3 class="h3 mt-3">Every call answered. Every lead followed up.</h3>
          <p class="mt-3 text-ink-600 text-[15.5px]">Missed-call text-back and automatic follow-ups, so nothing slips through the cracks.</p>
          <span class="mt-5 inline-flex items-center gap-2 text-[14.5px] font-semibold text-navy-700">AI Automation <Icon name="arrow-right" size={16} class="transition-transform group-hover:translate-x-1" /></span>
        </div>
      </a>

      <!-- 3. Get your time back -->
      <a href="/results/safe-haven-inspections/" class="pillar card lift group" data-reveal style="--d:180ms">
        <div class="pillar-ui">
          <div class="rounded-xl bg-white border border-stone-300 p-4 shadow-[0_8px_24px_-16px_rgba(3,14,29,.35)]">
            <div class="flex items-center justify-between text-[11px] font-mono uppercase tracking-wider text-ink-600"><span>Inspection report</span><span class="text-navy-700">Safe Haven</span></div>
            <div class="mt-4 space-y-3">
              <div>
                <div class="flex justify-between text-[12px] text-ink-600"><span>Before</span><span class="tabular">45 min</span></div>
                <div class="mt-1.5 h-2.5 rounded-full bg-[#e8d9d3]"><div class="h-full w-full rounded-full bg-[#c98b78]"></div></div>
              </div>
              <div>
                <div class="flex justify-between text-[12px] text-ink-900 font-semibold"><span>With automation</span><span class="tabular">10 min</span></div>
                <div class="mt-1.5 h-2.5 rounded-full bg-navy-100"><div class="h-full w-[22%] rounded-full bg-navy-700"></div></div>
              </div>
            </div>
            <div class="mt-4 flex items-center gap-2 text-[12px] text-navy-700 font-semibold"><Icon name="sparkles" size={15} />78% less time, every report</div>
          </div>
        </div>
        <div class="pillar-body">
          <div class="font-mono text-[11.5px] uppercase tracking-[0.1em] text-navy-700">03 · Get your time back</div>
          <h3 class="h3 mt-3">Let AI handle the busywork.</h3>
          <p class="mt-3 text-ink-600 text-[15.5px]">Reports, invoices, estimates, and reminders, handled by custom AI workflows built with tools like Claude, ChatGPT, and Grok.</p>
          <span class="mt-5 inline-flex items-center gap-2 text-[14.5px] font-semibold text-navy-700">See the Safe Haven result <Icon name="arrow-right" size={16} class="transition-transform group-hover:translate-x-1" /></span>
        </div>
      </a>
    </div>

    <div class="mt-14 flex flex-col lg:flex-row lg:items-center gap-5" data-reveal>
      <p class="font-mono text-[11.5px] uppercase tracking-[0.12em] text-ink-600 shrink-0">Built for</p>
      <ul class="flex flex-wrap gap-2">
        {industries.map((i) => <li class="chip bg-white border border-stone-300 text-ink-900 text-[13.5px]">{i}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .chain { display: flex; flex-wrap: wrap; gap: 8px 10px; font-family: var(--font-mono); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--color-ink-600); }
  .chain li { display: inline-flex; align-items: center; gap: 10px; }
  .chain .arr { color: var(--color-gold-700); }
  .chain .last { color: var(--color-navy-700); font-weight: 600; }
  .pillar { display: flex; flex-direction: column; overflow: hidden; border-radius: 20px; }
  .pillar-ui { padding: 22px; background: linear-gradient(180deg, var(--color-navy-50), var(--color-sand-100)); border-bottom: 1px solid var(--color-stone-300); height: 268px; display: flex; flex-direction: column; justify-content: center; }
  .pillar-body { padding: 26px 26px 28px; display: flex; flex-direction: column; flex: 1; }
  .pillar-body > span { margin-top: auto; padding-top: 18px; }
  .flow { position: relative; display: grid; gap: 9px; font-size: 13px; }
  .flow::before { content: ''; position: absolute; left: 15px; top: 16px; bottom: 16px; width: 1px; background: repeating-linear-gradient(to bottom, var(--color-navy-300) 0 4px, transparent 4px 8px); }
  .flow li { position: relative; display: flex; align-items: center; gap: 10px; background: #fff; border: 1px solid var(--color-stone-300); border-radius: 12px; padding: 6px 10px 6px 6px; color: var(--color-ink-900); }
  .flow .t { margin-left: auto; font-family: var(--font-mono); font-size: 10.5px; color: var(--color-ink-600); }
  .node { width: 22px; height: 22px; border-radius: 7px; display: inline-flex; align-items: center; justify-content: center; background: var(--color-navy-100); color: var(--color-navy-700); flex-shrink: 0; }
  .node :global(svg) { width: 13px; height: 13px; }
  .node-warn { background: #f7e3dc; color: #8a2d1f; }
  .node-good { background: var(--color-navy-700); color: #fff; }
  .node-gold { background: #fbf3dc; color: var(--color-gold-700); }
</style>
