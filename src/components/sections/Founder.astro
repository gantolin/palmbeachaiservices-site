---
import Icon from '../ui/Icon.astro';
import { SITE, FOUNDER_FIRST_NAME, CTA, telHref } from '@/config/site';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
// TODO(Gino): replace the placeholder with a real editorial portrait (set SITE.founderPhoto in src/config/site.ts).
---
<section class="section surface-sand relative overflow-hidden" id="founder">
  <div class="container-x">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16 items-center">
      <div class="lg:col-span-5" data-reveal>
        <div class="portrait relative mx-auto max-w-[440px] aspect-[4/5] rounded-[24px] overflow-hidden">
          {SITE.founderPhoto ? (
            <img src={SITE.founderPhoto} alt={`${FOUNDER_FIRST_NAME}, founder of ${SITE.name}`} class="absolute inset-0 w-full h-full object-cover" loading="lazy" decoding="async" width="880" height="1100" />
          ) : (
            <div class="absolute inset-0 glow-navy flex flex-col items-center justify-center text-center p-10">
              <img src="/brand/logo-mark-white.svg" alt="" width="108" height="140" class="h-[140px] w-auto opacity-95 drop-shadow-[0_18px_40px_rgba(0,0,0,.45)]" loading="lazy" decoding="async" />
              <div class="mt-6 font-serif italic text-[44px] text-gold-300 leading-none">{FOUNDER_FIRST_NAME}</div>
              <div class="mt-3 font-mono text-[11px] uppercase tracking-[0.14em] text-mist-400">Founder · {SITE.homeBase}, FL</div>
            </div>
          )}
          <div class="absolute left-4 bottom-4 right-4 flex items-center gap-3 rounded-2xl bg-navy-950/80 backdrop-blur px-4 py-3 border border-white/10">
            <Icon name="pin" size={18} class="text-gold-300 shrink-0" />
            <div class="text-[13px] leading-tight text-mist-200"><span class="font-semibold">Based in {SITE.homeBase}</span><br /><span class="text-mist-400">Serving all of Palm Beach County</span></div>
          </div>
        </div>
      </div>
      <div class="lg:col-span-7" data-reveal style="--d:100ms">
        <div class="eyebrow">Meet the founder</div>
        <h2 class="h2 mt-5">Hi, I'm {FOUNDER_FIRST_NAME}. You'll work <em class="accent">with me,</em> not an account manager.</h2>
        <div class="mt-7 space-y-5 text-[17px] leading-relaxed text-ink-900/90 max-w-[60ch]">
          <p>I'm a local, founder-run shop in {SITE.homeBase}. I build every website, set up every Google profile, and wire up every automation myself, so the person you talk to is the person doing the work.</p>
          <p>I use the same AI tools the big companies use (Claude, ChatGPT, and Grok) to build simple systems for local owners: missed-call text-back, review requests, follow-ups, and custom tools like the one that cut Safe Haven Inspections' report time from 45 to 10 minutes.</p>
          {!compact && <p>Because I do the work myself, I take a limited number of clients per trade, per town. That way you never compete with another client of mine for the same customers.</p>}
        </div>
        <div class="mt-9 flex flex-col sm:flex-row gap-4 sm:items-center">
          <a href={CTA.primary.href} class="btn btn-navy">Book your free teardown with {FOUNDER_FIRST_NAME}<Icon name="arrow-right" size={17} /></a>
          <a href={telHref} class="inline-flex items-center gap-2 font-semibold text-navy-700 hover:text-navy-800 min-h-11"><Icon name="phone" size={17} />{SITE.phone}</a>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .portrait { box-shadow: 0 40px 80px -40px rgba(3, 14, 29, .55); }
</style>
