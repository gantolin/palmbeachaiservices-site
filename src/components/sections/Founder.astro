---
/**
 * Who the owner works with. Back on the site 2026-11-23 (Gene: "let's put our name and photo on the site").
 * The portrait only renders once SITE.founderPhoto is set, so there is never a placeholder picture.
 */
import Icon from '../ui/Icon.astro';
import { SITE, FOUNDER_FIRST_NAME, CTA, telHref } from '@/config/site';
interface Props { surface?: string }
const { surface = 'surface-sand' } = Astro.props;
const hasPhoto = Boolean(SITE.founderPhoto);
---
<section class:list={['py-14 sm:py-20 relative overflow-hidden', surface]} id="founder">
  <div class="container-x">
    <div class:list={['grid gap-10 items-center', hasPhoto ? 'lg:grid-cols-12 lg:gap-16' : 'max-w-3xl']}>
      {hasPhoto && (
        <div class="lg:col-span-4">
          <div class="portrait relative mx-auto max-w-[340px] aspect-[4/5] rounded-[24px] overflow-hidden">
            <img src={SITE.founderPhoto} alt={`${FOUNDER_FIRST_NAME}, owner of ${SITE.name}`} class="absolute inset-0 w-full h-full object-cover" loading="lazy" decoding="async" width="680" height="850" />
          </div>
        </div>
      )}
      <div class:list={[hasPhoto && 'lg:col-span-8']}>
        <div class="eyebrow">Who you will work with</div>
        <h2 class="h2 mt-4 text-ink-900">Hi, I'm {FOUNDER_FIRST_NAME}. You'll work with me, not an account manager.</h2>
        <p class="mt-6 text-[17px] leading-relaxed text-ink-900/90 max-w-[60ch]">I run {SITE.name}. I build every website and set up every Google Business Profile myself, so the person you talk to is the person doing the work.</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-4 sm:items-center">
          <a href={CTA.primary.href} class="btn btn-navy">{CTA.primary.label} with {FOUNDER_FIRST_NAME}<Icon name="arrow-right" size={17} /></a>
          <a href={telHref} class="inline-flex items-center gap-2 font-semibold text-navy-700 hover:text-navy-800 min-h-11"><Icon name="phone" size={17} />{SITE.phone}</a>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .portrait { box-shadow: 0 40px 80px -40px rgba(3, 14, 29, .55); }
</style>
