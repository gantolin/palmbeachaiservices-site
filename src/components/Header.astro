---
import Logo from './ui/Logo.astro';
import Icon from './ui/Icon.astro';
import { NAV, CTA, SITE, telHref, smsHref } from '@/config/site';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-gold-500 focus:text-navy-950 focus:px-4 focus:py-2 focus:rounded-full">Skip to content</a>

<header id="site-header" data-open="false" class="site-header sticky top-0 z-40 text-mist-200">
  <div class="container-x flex items-center justify-between h-[76px] lg:h-[92px] gap-2 sm:gap-3 lg:gap-6">
    <a href="/" class="header-logo shrink-0 rounded-lg" aria-label={`${SITE.name} home`}><Logo height={64} class="h-[30px] w-auto min-[350px]:h-[34px] min-[380px]:h-[38px] min-[420px]:h-[44px] sm:h-[56px] lg:h-[64px]" /></a>

    <nav aria-label="Main" class="hidden lg:flex items-center gap-1">
      {NAV.map((n) => (
        <a href={n.href} class:list={['px-3.5 py-2 rounded-full text-[14.5px] font-medium transition-colors', isActive(n.href) ? 'text-white bg-white/8' : 'text-mist-200/80 hover:text-white hover:bg-white/5']} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>

    <div class="hidden lg:flex items-center gap-2">
      <a href={telHref} class="inline-flex items-center gap-2 px-3 py-2 rounded-full text-[19px] font-semibold tracking-tight text-white hover:bg-white/5"><Icon name="phone" size={19} /> {SITE.phone}</a>
      <a href={smsHref} class="btn btn-sm text-mist-200 hover:text-white hover:bg-white/5"><Icon name="message" size={16} /> Text us</a>
      <a href={CTA.primary.href} class="btn btn-primary btn-sm btn-shine" data-magnetic>Book a free audit <Icon name="arrow-right" size={16} /></a>
    </div>

    <a href={telHref} class="head-phone lg:hidden ml-auto" aria-label={`Call ${SITE.phone}`}><Icon name="phone" size={15} class="head-phone-icon" />{SITE.phone}</a>

    <button type="button" class="lg:hidden shrink-0 inline-flex items-center justify-center size-11 -mr-2 rounded-full hover:bg-white/5" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <Icon name="menu" size={24} />
    </button>
  </div>

  <div class="scroll-progress" aria-hidden="true"></div>

  <div id="mobile-menu" class="mobile-sheet lg:hidden" hidden>
    <div class="container-x pb-8 pt-2">
      <nav aria-label="Mobile" class="flex flex-col">
        {NAV.map((n) => (
          <a href={n.href} class="flex items-center justify-between py-4 border-b border-white/8 text-[20px] font-display font-medium tracking-tight">{n.label}<Icon name="arrow-right" size={18} class="text-gold-300" /></a>
        ))}
      </nav>
      <div class="mt-6 grid gap-3">
        <a href={CTA.primary.href} class="btn btn-primary btn-lg w-full">{CTA.primary.label}<Icon name="arrow-right" size={18} /></a>
        <a href={telHref} class="btn btn-outline-dark btn-lg w-full"><Icon name="phone" size={18} /> Call {SITE.phone}</a>
        <a href={smsHref} class="btn btn-outline-dark btn-lg w-full"><Icon name="message" size={18} /> Text {SITE.phone}</a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header { transition: background-color 300ms, backdrop-filter 300ms, border-color 300ms, box-shadow 300ms; border-bottom: 1px solid transparent; background: #030e1d; }
  .site-header[data-scrolled='true'], .site-header[data-open='true'] {
    background: rgba(3, 14, 29, 0.84);
    backdrop-filter: saturate(160%) blur(18px);
    -webkit-backdrop-filter: saturate(160%) blur(18px);
    border-bottom-color: rgba(230, 233, 240, 0.08);
    box-shadow: 0 10px 30px -18px rgba(0, 0, 0, 0.7), inset 0 -1px 0 rgba(255, 255, 255, 0.03);
  }
  /* Shrink effect without layout shift: header height is fixed, only the logo scales (transform). */
  .header-logo { transform-origin: 0 50%; transition: transform 350ms cubic-bezier(.22, 1, .36, 1); }
  .site-header[data-scrolled='true'] .header-logo { transform: scale(0.9); }
  .site-header[data-open='true'] { background: rgba(3, 14, 29, 0.98); }
  /* Phones: the bar stays solid while scrolling, so the white cards do not show through it. */
  @media (max-width: 1023px) { .site-header[data-scrolled='true'] { background: #030e1d; backdrop-filter: none; -webkit-backdrop-filter: none; } }
  .mobile-sheet { max-height: calc(100dvh - 76px); overflow-y: auto; }

  /* Phone number in the top bar on phones: a gold-edged pill, so it reads as a button to tap. */
  .head-phone {
    display: inline-flex; align-items: center; gap: 6px; height: 40px; padding: 0 13px 0 10px; border-radius: 999px;
    white-space: nowrap; color: #fff; font-size: 15.5px; font-weight: 600; letter-spacing: -0.01em;
    background: linear-gradient(180deg, rgba(230, 205, 131, .2), rgba(230, 205, 131, .08));
    border: 1px solid rgba(230, 205, 131, .55);
    box-shadow: 0 1px 0 rgba(255, 255, 255, .12) inset, 0 6px 18px -10px rgba(201, 162, 39, .7);
    transition: background-color 150ms;
  }
  .head-phone:active { background: rgba(230, 205, 131, .32); }
  .head-phone :global(.head-phone-icon) { color: var(--color-gold-300); flex: none; }
  @media (min-width: 640px) { .head-phone { font-size: 18px; height: 44px; padding: 0 18px 0 14px; gap: 8px; } }
  /* The desktop bar has its own number; this rule has to repeat lg:hidden because display is set above. */
  @media (min-width: 1024px) { .head-phone { display: none; } }
  @media (max-width: 379px) { .head-phone { font-size: 14.5px; height: 38px; padding: 0 11px; } .head-phone :global(.head-phone-icon) { display: none; } }
  @media (max-width: 349px) { .head-phone { font-size: 14px; padding: 0 9px; } }
</style>
