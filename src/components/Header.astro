---
import Logo from './ui/Logo.astro';
import Icon from './ui/Icon.astro';
import { NAV, CTA, SITE, telHref } from '@/config/site';
import { services } from '@/data/services';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-gold-500 focus:text-navy-950 focus:px-4 focus:py-2 focus:rounded-full">Skip to content</a>

<div class="announce relative z-50 bg-navy-900 text-mist-200 text-[13px] border-b border-white/5">
  <div class="container-x flex items-center justify-center gap-3 h-9">
    <span class="inline-flex size-2 rounded-full bg-gold-500 shadow-[0_0_0_4px_rgba(201,162,39,.18)]"></span>
    <span class="truncate"><span class="sm:hidden">Limited clients per trade, per town.</span><span class="hidden sm:inline">We take a limited number of clients per trade, per town.</span></span>
    <a href="/pricing/" class="hidden sm:inline-flex items-center gap-1 text-gold-300 hover:text-gold-400 font-medium">See pricing <Icon name="arrow-right" size={14} /></a>
  </div>
</div>

<header id="site-header" data-open="false" class="site-header sticky top-0 z-40 text-mist-200">
  <div class="container-x flex items-center justify-between h-[68px] gap-6">
    <a href="/" class="shrink-0 rounded-lg" aria-label={`${SITE.name} home`}><Logo height={40} class="h-[36px] w-auto sm:h-[40px]" /></a>

    <nav aria-label="Main" class="hidden lg:flex items-center gap-1">
      {NAV.map((n) => (
        <a href={n.href} class:list={['px-3.5 py-2 rounded-full text-[14.5px] font-medium transition-colors', isActive(n.href) ? 'text-white bg-white/8' : 'text-mist-200/80 hover:text-white hover:bg-white/5']} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>

    <div class="hidden lg:flex items-center gap-2">
      <span class="local-time hidden xl:inline-flex items-center gap-2 font-mono text-[11.5px] uppercase tracking-[0.08em] text-mist-400 mr-2" aria-hidden="true">
        <span class="size-1.5 rounded-full bg-navy-300"></span>Royal Palm Beach <span data-local-time class="tabular text-mist-200">--:--</span>
      </span>
      <a href={telHref} class="btn btn-sm text-mist-200 hover:text-white hover:bg-white/5"><Icon name="phone" size={16} /> {SITE.phone}</a>
      <a href={CTA.primary.href} class="btn btn-primary btn-sm">Free teardown <Icon name="arrow-right" size={16} /></a>
    </div>

    <button type="button" class="lg:hidden inline-flex items-center justify-center size-11 -mr-2 rounded-full hover:bg-white/5" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <Icon name="menu" size={24} />
    </button>
  </div>

  <div id="mobile-menu" class="mobile-sheet lg:hidden" hidden>
    <div class="container-x pb-8 pt-2">
      <nav aria-label="Mobile" class="flex flex-col">
        {NAV.map((n) => (
          <a href={n.href} class="flex items-center justify-between py-4 border-b border-white/8 text-[20px] font-display font-medium tracking-tight">{n.label}<Icon name="arrow-right" size={18} class="text-gold-300" /></a>
        ))}
        <div class="pt-4 pb-2 font-mono text-[11px] uppercase tracking-[0.12em] text-mist-400">Services</div>
        {services.map((s) => (
          <a href={`/services/${s.slug}/`} class="py-2 text-mist-200/85 text-[16px]">{s.name}</a>
        ))}
      </nav>
      <div class="mt-6 grid gap-3">
        <a href={CTA.primary.href} class="btn btn-primary btn-lg w-full">{CTA.primary.label}<Icon name="arrow-right" size={18} /></a>
        <a href={telHref} class="btn btn-outline-dark btn-lg w-full"><Icon name="phone" size={18} /> Call {SITE.phone}</a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header { transition: background-color 250ms, backdrop-filter 250ms, border-color 250ms; border-bottom: 1px solid transparent; background: #030e1d; }
  .site-header[data-scrolled='true'], .site-header[data-open='true'] {
    background: rgba(3, 14, 29, 0.82);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    border-bottom-color: rgba(230, 233, 240, 0.08);
  }
  .site-header[data-open='true'] { background: rgba(3, 14, 29, 0.98); }
  .mobile-sheet { max-height: calc(100dvh - 68px); overflow-y: auto; }
</style>
