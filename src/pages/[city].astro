---
/**
 * City landing pages (/seo-company-<city>/), one per entry in src/data/cities.ts.
 * Each page targets "seo <city>" searches. Keyword data and the rule for adding a city are in docs/keyword-map.md:
 * only add a city with genuinely local content, never a find-and-replace copy of another city.
 */
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/sections/PageHero.astro';
import CaseStudies from '@/components/sections/CaseStudies.astro';
import PricingPlan from '@/components/sections/PricingPlan.astro';
import FAQ from '@/components/sections/FAQ.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';
import Icon from '@/components/ui/Icon.astro';
import { SITE, CTA, telHref } from '@/config/site';
import { services } from '@/data/services';
import { cities, cityPath, sharedReasons, type City } from '@/data/cities';
import { accent } from '@/lib/text';

export function getStaticPaths() {
  return cities.map((city) => ({ params: { city: `seo-company-${city.slug}` }, props: { city } }));
}

const { city } = Astro.props as { city: City };
const path = cityPath(city);
const crumbs = [{ name: 'Home', url: '/' }, { name: `SEO Company in ${city.name}`, url: path }];
const reasons = [city.localReason, ...sharedReasons];
const others = cities.filter((c) => c.slug !== city.slug);

const pageLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `SEO services in ${city.name}`,
  serviceType: 'Local SEO',
  url: `${SITE.url}${path}`,
  provider: { '@id': `${SITE.url}/#business` },
  areaServed: { '@type': city.placeType, name: `${city.name}, FL` },
};
---
<Base
  title={city.seoTitle}
  description={city.metaDescription}
  faqs={city.faqs}
  breadcrumbs={crumbs}
  schema={[pageLd]}
>
  <PageHero
    eyebrow={`SEO company · ${city.name}, FL`}
    title={city.heroTitle}
    lede={city.heroLede}
    crumbs={crumbs}
  >
    <div class="mt-9 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6 fade-in" style="--d:420ms">
      <a href={CTA.primary.href} class="btn btn-primary btn-lg btn-shine" data-magnetic>{CTA.primary.label}<Icon name="arrow-right" size={18} /></a>
      <a href={telHref} class="link-mono self-start sm:self-auto"><Icon name="phone" size={14} /> {SITE.phone}</a>
    </div>
  </PageHero>

  <section class="section surface-cream">
    <div class="container-x">
      <div class="max-w-3xl" data-reveal>
        <div class="eyebrow">Why {city.name} owners work with us</div>
        <h2 class="h2 mt-5" set:html={accent(city.whyTitle)} />
        <p class="lede mt-6">{city.whyText}</p>
      </div>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {reasons.map((r, i) => (
          <div class="card p-7 rounded-[20px]" data-reveal style={`--d:${i * 80}ms`}>
            <span class="size-11 rounded-xl bg-navy-100 text-navy-700 flex items-center justify-center"><Icon name={r.icon} size={20} /></span>
            <h3 class="mt-5 font-display text-[19px] font-[600] tracking-tight">{r.title}</h3>
            <p class="mt-2 text-ink-600 text-[15px]">{r.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {city.market && (
    <section class="section surface-sand">
      <div class="container-x">
        <div class="max-w-3xl" data-reveal>
          <div class="eyebrow">The {city.name} market</div>
          <h2 class="h2 mt-5" set:html={accent(city.market.title)} />
          {city.market.paragraphs.map((p) => <Fragment><p class="lede mt-6">{p}</p>{'\n'}</Fragment>)}
        </div>
        <div class="mt-12 grid gap-4 grid-cols-2 lg:grid-cols-4">
          {city.market.stats.map((s, i) => (
            <div class="card p-6 rounded-[20px]" data-reveal style={`--d:${i * 70}ms`}>
              <div class="font-display text-[30px] font-[600] tracking-tight text-navy-700">{s.value}</div>
              <div class="mt-1 text-[14.5px] text-ink-600">{s.label}</div>
            </div>
          ))}
        </div>
        <div class="mt-12 grid gap-8 lg:grid-cols-2" data-reveal>
          <div>
            <h3 class="font-display text-[20px] font-[600] tracking-tight">Neighborhoods we cover in {city.name}</h3>
            <ul class="mt-4 flex flex-wrap gap-2">
              {city.market.neighborhoods.map((n) => <li class="chip border border-stone-300 bg-white text-ink-900 text-[13.5px] py-1">{n}</li>)}
            </ul>
          </div>
          <div>
            <h3 class="font-display text-[20px] font-[600] tracking-tight">Getting to you</h3>
            <p class="mt-4 text-ink-600 text-[15.5px]">{city.market.gettingThere}</p>
          </div>
        </div>
        <p class="mt-10 font-mono text-[11.5px] text-ink-600 max-w-3xl">{city.market.sourceNote}</p>
      </div>
    </section>
  )}

  <section class={`section ${city.market ? 'surface-cream' : 'surface-sand'}`}>
    <div class="container-x">
      <div class="max-w-2xl" data-reveal>
        <div class="eyebrow">What we do for {city.name} businesses</div>
        <h2 class="h2 mt-5">Get seen on Google. Get your time back <em class="accent">with AI.</em></h2>
      </div>
      <div class="mt-12 grid gap-4 md:grid-cols-2">
        {services.map((s, i) => (
          <a href={`/services/${s.slug}/`} class="card lift group flex items-start gap-5 p-7 rounded-[20px]" data-reveal style={`--d:${i * 70}ms`}>
            <span class="size-12 shrink-0 rounded-2xl bg-navy-700 text-gold-300 flex items-center justify-center"><Icon name={s.icon} size={22} /></span>
            <div class="min-w-0">
              <div class="font-mono text-[11px] uppercase tracking-[0.1em] text-navy-700">{s.pillar}</div>
              <h3 class="mt-1 font-display text-[20px] font-[600] tracking-tight">{s.name}</h3>
              <p class="mt-2 text-[15px] text-ink-600">{s.outcomes.map((o) => o.title).join(' · ')}</p>
            </div>
            <Icon name="arrow-right" size={18} class="ml-auto mt-1 shrink-0 text-navy-700 transition-transform group-hover:translate-x-1" />
          </a>
        ))}
      </div>
      <p class="mt-10 text-ink-600 max-w-3xl" data-reveal>
        Want to see how you stack up first? Our free <a href={CTA.primary.href} class="text-navy-700 font-semibold underline">Google Visibility Check</a> shows
        where you show up on Google Maps in {city.name}, who is ahead of you, and what to fix first. New to this? Start with our guide on
        <a href="/guides/local-seo-for-contractors/" class="text-navy-700 font-semibold underline">local SEO for contractors</a>.
      </p>
    </div>
  </section>

  <CaseStudies eyebrow="Proof from Palm Beach County" title="Real results for *local* businesses near you." />

  <section class="section surface-cream" id="whats-included">
    <div class="container-x">
      <div class="mx-auto max-w-3xl text-center" data-reveal>
        <div class="eyebrow justify-center">What you get</div>
        <h2 class="h2 mt-5">One plan. <em class="accent">Everything</em> included.</h2>
        <p class="lede mt-6 mx-auto">A one-time website build, then one flat monthly plan for everything that keeps you seen on Google in {city.name}. No tiers, no contract, and a fixed quote in writing before we start.</p>
      </div>
      <div class="mt-12"><PricingPlan showPromises={false} /></div>
    </div>
  </section>

  <FAQ faqs={city.faqs} title={`${city.name} SEO: *questions*`} surface="surface-sand" />

  <section class="surface-sand pb-16">
    <div class="container-x">
      <div class="border-t border-stone-300 pt-8" data-reveal>
        <div class="font-mono text-[11.5px] uppercase tracking-[0.12em] text-ink-600">Other Palm Beach County cities</div>
        <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-[15px]">
          {others.map((c) => <li><a href={cityPath(c)} class="text-navy-700 font-medium underline underline-offset-4">SEO in {c.name}</a></li>)}
        </ul>
      </div>
    </div>
  </section>

  <FinalCTA />
</Base>
