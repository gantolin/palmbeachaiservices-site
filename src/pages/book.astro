---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/ui/Icon.astro';
import BookingEmbed from '@/components/islands/BookingEmbed.astro';
import { SITE, FOUNDER_FIRST_NAME, CTA, telHref } from '@/config/site';
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Book a call', url: '/book/' }];
---
<Base
  title="Book a Free Call | Palm Beach AI Services, Royal Palm Beach FL"
  description={`Pick a time for a free 30-minute call with ${FOUNDER_FIRST_NAME} about your website, Google Business Profile, and lead follow-up. For Palm Beach County home-service businesses.`}
  breadcrumbs={crumbs}
>
  <section class="relative overflow-hidden surface-dark grain -mt-px">
    <div class="hero-bloom absolute inset-0 glow-navy" aria-hidden="true"></div>
    <div class="container-x relative py-20 sm:py-24">
      <div class="max-w-3xl mx-auto text-center">
        <div class="eyebrow justify-center">{CTA.offerName} · free</div>
        <h1 class="h1 mt-5 text-[#f4f1e8]">Book a free <em class="accent">30-minute</em> call.</h1>
        <p class="lede mt-5 mx-auto">
          Tell {FOUNDER_FIRST_NAME} your business name when you book. Before the call, {FOUNDER_FIRST_NAME} checks where you show up on Google and reviews your profile and website,
          and on the call you get the fixes that will bring in more calls. You keep them whether or not we work together.
        </p>
        <div class="mt-10 text-left">
          <BookingEmbed />
        </div>
        <p class="mt-10 text-mist-400 text-[15px]">
          Rather tell us about your business first? <a href={CTA.primary.href} class="text-gold-300 underline underline-offset-4">Fill in the 2-minute Google check form</a>,
          or call <a href={telHref} class="text-gold-300 underline underline-offset-4 whitespace-nowrap"><Icon name="phone" size={14} class="inline" /> {SITE.phone}</a>.
        </p>
      </div>
    </div>
  </section>
</Base>
