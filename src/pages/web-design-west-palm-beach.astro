---
/**
 * Targets "web design west palm beach" (110 searches a month in Palm Beach County, DataForSEO Google Ads,
 * 2026-11-23), with "website design west palm beach" as the secondary.
 * City facts: U.S. Census Bureau ACS 2024 5-year estimates.
 */
import LocalPage from '@/components/sections/LocalPage.astro';

const faqs = [
  { q: 'How much does a website cost in West Palm Beach?', a: 'It depends on how many services and towns the site needs to cover. We go over pricing on the free audit call.' },
  { q: 'Can you fix my current website instead of building a new one?', a: 'Yes. We build new websites and we fix existing ones. On the audit we look at your current site and tell you which makes more sense.' },
  { q: 'Will my West Palm Beach website show up on Google?', a: 'That is what it is built for. Each service and each town gets its own page, with the words people search in the title and the heading. Google decides the rankings, so we do not promise a position.' },
  { q: 'Do you only build websites for West Palm Beach businesses?', a: 'No. We work with local businesses across Palm Beach County, from Jupiter to Boca Raton.' },
  { q: 'What do I need for the free audit?', a: 'Your business name and city. A link to your current website helps if you have one.' },
];
---
<LocalPage
