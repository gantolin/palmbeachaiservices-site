---
import Aurora from '@/components/ui/Aurora.astro';
import Base from '@/layouts/Base.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';
import Visual from '@/components/sections/CaseStudyVisual.astro';
import Icon from '@/components/ui/Icon.astro';
import { caseStudies, type CaseStudy } from '@/data/caseStudies';
import { words } from '@/lib/text';
import { CTA } from '@/config/site';

export function getStaticPaths() {
  return caseStudies.map((c) => ({ params: { slug: c.slug }, props: { cs: c } }));
}
const { cs } = Astro.props as { cs: CaseStudy };
const idx = caseStudies.findIndex((c) => c.slug === cs.slug);
const next = caseStudies[(idx + 1) % caseStudies.length];
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Results', url: '/results/' }, { name: cs.client, url: `/results/${cs.slug}/` }];
const inProgress = cs.status === 'in-progress';
---
<Base title={`${cs.client}: ${cs.headlineStat} ${cs.headlineLabel} | Palm Beach AI Services`} description={cs.summary} breadcrumbs={crumbs}>
  <section class="relative overflow-hidden surface-dark grain -mt-px" data-parallax-root>
    <div class="hero-bloom absolute inset-0 glow-navy" aria-hidden="true"></div>
    <Aurora variant="soft" />
    <div class="container-x relative pt-14 pb-20 sm:pt-20 lg:pb-24">
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex flex-wrap items-center gap-2 font-mono text-[11.5px] uppercase tracking-[0.1em] text-mist-400">
          {crumbs.map((c, i) => (
            <li class="flex items-center gap-2">
              {i < crumbs.length - 1 ? <a href={c.url} class="hover:text-gold-300">{c.name}</a> : <span aria-current="page" class="text-mist-200">{c.name}</span>}
              {i < crumbs.length - 1 && <span aria-hidden="true">/</span>}
            </li>
          ))}
        </ol>
      </nav>
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-14 items-center">
        <div class="lg:col-span-7">
          <div class="flex flex-wrap items-center gap-3 fade-in">
            <span class="eyebrow">Case study</span>
            {inProgress && <span class="chip bg-gold-500/15 text-gold-300 border border-gold-300/30 text-[12px] py-1 font-semibold">Rebuilt · results in progress</span>}
          </div>
          <h1 class="h1 mt-6 text-[#f4f1e8] word-rise" set:html={words(cs.title)} />
          <p class="lede mt-7 fade-in" style="--d:320ms">{cs.summary}</p>
          <dl class="mt-9 grid grid-cols-2 sm:grid-cols-3 gap-x-6 gap-y-4 max-w-xl fade-in" style="--d:420ms">
            <div><dt class="font-mono text-[11px] uppercase tracking-[0.1em] text-mist-400">Client</dt><dd class="mt-1 text-mist-200 font-medium">{cs.client}</dd></div>
            <div><dt class="font-mono text-[11px] uppercase tracking-[0.1em] text-mist-400">Trade</dt><dd class="mt-1 text-mist-200 font-medium">{cs.trade}</dd></div>
            <div class="col-span-2 sm:col-span-1"><dt class="font-mono text-[11px] uppercase tracking-[0.1em] text-mist-400">Area</dt><dd class="mt-1 text-mist-200 font-medium">{cs.area}</dd></div>
          </dl>
        </div>
        <div class="lg:col-span-5 fade-in" style="--d:220ms">
          <div class="rounded-[24px] p-3 bg-white/5 border border-white/10"><Visual kind={cs.visual} size="lg" /></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stat band -->
  <section class="surface-cream border-b border-stone-300/70">
    <div class="container-x py-12 grid gap-4 sm:grid-cols-3">
      {cs.stats.map((s) => (
        <div class="rounded-2xl bg-white border border-stone-300 p-6">
          <div class:list={['font-display font-[600] tracking-[-0.04em] leading-none tabular', inProgress ? 'text-[30px] text-ink-900' : 'text-[40px] text-navy-700']}>
            {s.countTo !== undefined ? <span data-count-to={s.countTo} data-suffix={s.suffix ?? ''} data-prefix={s.prefix ?? ''}>{s.value}</span> : s.value}
          </div>
          <div class="mt-3 text-[14.5px] text-ink-600">{s.label}</div>
        </div>
      ))}
      <p class="sm:col-span-3 font-mono text-[12px] leading-relaxed text-ink-600 border-t border-dashed border-stone-300 pt-4"><span class="text-navy-700 font-semibold">The math:</span> {cs.proofMath}</p>
    </div>
  </section>

  <section class="section surface-cream !pt-20">
    <div class="container-x grid gap-14 lg:grid-cols-12">
      <aside class="lg:col-span-4 order-2 lg:order-1">
        <div class="lg:sticky lg:top-28 space-y-5">
          <div class="card p-6 rounded-[18px]">
            <div class="font-mono text-[11px] uppercase tracking-[0.1em] text-ink-600">Services</div>
            <ul class="mt-3 flex flex-wrap gap-2">{cs.services.map((s) => <li class="chip bg-navy-100 text-navy-800 text-[13px]">{s}</li>)}</ul>
            <div class="mt-6 font-mono text-[11px] uppercase tracking-[0.1em] text-ink-600">Status</div>
            <p class="mt-2 text-[15px] font-medium">{inProgress ? 'Live. Waiting to rank.' : 'Live and delivering.'}</p>
          </div>
          <div class="rounded-[18px] bg-navy-950 p-6 text-mist-200">
            <p class="font-display text-[20px] font-[600] tracking-tight leading-snug">Want results like this in your town?</p>
            <p class="mt-2 text-[14.5px] text-mist-400">Start with a free teardown of your Google profile and website.</p>
            <a href={CTA.primary.href} class="btn btn-primary w-full mt-5">{CTA.primary.label}<Icon name="arrow-right" size={17} /></a>
          </div>
        </div>
      </aside>
      <article class="lg:col-span-8 order-1 lg:order-2 max-w-[70ch]">
        <div data-reveal>
          <div class="eyebrow">The challenge</div>
          <p class="mt-4 font-display text-[clamp(1.4rem,2.4vw,1.9rem)] font-[500] tracking-[-0.02em] leading-snug text-ink-900">{cs.challenge}</p>
        </div>
        <div class="mt-14" data-reveal>
          <div class="eyebrow">What we did</div>
          <ol class="mt-6 space-y-4">
            {cs.whatWeDid.map((w, i) => (
              <li class="flex gap-5 items-start">
                <span class="shrink-0 size-9 rounded-full border border-navy-700/40 text-navy-700 font-mono text-[13px] flex items-center justify-center">{i + 1}</span>
                <span class="pt-1.5 text-[17px]">{w}</span>
              </li>
            ))}
          </ol>
        </div>
        <div class="mt-14" data-reveal>
          <div class="eyebrow">{inProgress ? 'Where it stands' : 'The result'}</div>
          <ul class="mt-6 space-y-3">
            {cs.outcome.map((o) => (
              <li class="flex gap-3 items-start text-[17px]"><Icon name={inProgress ? 'clock' : 'check-circle'} size={21} class={inProgress ? 'text-gold-700 shrink-0 mt-[3px]' : 'text-navy-700 shrink-0 mt-[3px]'} />{o}</li>
            ))}
          </ul>
          {cs.timeMath && (
            <div class="mt-8 rounded-2xl bg-navy-50 border border-navy-100 p-6 flex gap-4">
              <Icon name="clock" size={22} class="text-navy-700 shrink-0" />
              <p class="text-[16px]"><strong class="font-semibold">In time terms:</strong> {cs.timeMath}</p>
            </div>
          )}
        </div>
        <p class="mt-12 text-[13px] text-ink-600">Real client result, shared with context. Every business and market is different; this is an example of what we delivered, not a promise of the same numbers for yours.</p>
        <!-- TODO(Gino): add an owner quote here once you have written permission (see src/data/testimonials.ts). -->
        <!-- TODO(Gino): add before/after screenshots (Google rankings, GBP insights, site) to /public/images/results/. -->
        <div class="mt-16 pt-8 border-t border-stone-300 flex items-center justify-between gap-4">
          <a href="/results/" class="link-mono"><span aria-hidden="true">←</span> All results</a>
          <a href={`/results/${next.slug}/`} class="group inline-flex items-center gap-2 text-[15px] font-semibold text-navy-700">Next: {next.client}<Icon name="arrow-right" size={16} class="transition-transform group-hover:translate-x-1" /></a>
        </div>
      </article>
    </div>
  </section>
  <FinalCTA />
</Base>
