---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/sections/PageHero.astro';
import Trades from '@/components/sections/Trades.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';
import { caseStudies } from '@/data/caseStudies';

/**
 * Numbers roll up (or down) to their value when they scroll into view. Only whole numbers of 10 or
 * more are animated: "10+", "78%", "35 min", and the second number in "45 → 10 min". Anything else
 * ("5.8 hrs", "Map pack", "2 restaurants") is returned as plain text. The script in motion.ts does
 * the counting and leaves the real value in the HTML for Google and for reduced motion.
 */
function roll(text: string) {
  const range = text.match(/^(\d+) → (\d+)(\D*)$/);
  if (range) return [`${range[1]} → `, { from: Number(range[1]), to: Number(range[2]), suffix: range[3] }];
  const one = text.match(/^(\d+)(\D*)$/);
  if (one && Number(one[1]) >= 10) return ['', { from: 0, to: Number(one[1]), suffix: one[2] }];
  return [text, null];
}
---
<Base
  title="Local SEO & AI Results for Palm Beach County Businesses"
  description="Safe Haven Inspections cut report time from 45 minutes to 10. Hero's Pavers shows up in the Google map pack for more than 10 keywords."
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Results', url: '/results/' }]}
>
  <PageHero compact eyebrow="Results" title="Results from local businesses."
    lede="Businesses we work with, and what changed for each one." />

  <section class="surface-cream py-12 sm:py-16">
    <div class="container-x space-y-6">
      {caseStudies.map((c) => (
        <article class="card rounded-[20px] p-7 sm:p-9 grid gap-6 lg:grid-cols-12 lg:gap-12">
          <div class="lg:col-span-5">
            {c.logo && <img src={c.logo.src} alt={`${c.client} logo`} width={c.logo.width} height={c.logo.height} class="mb-6 h-14 w-auto max-w-[240px] object-contain object-left" loading="lazy" decoding="async" />}
            <h2 class="h3 text-ink-900">{c.client}</h2>
            <p class="mt-1.5 text-[15px] text-ink-600">{c.trade} · {c.area}</p>
            <div class:list={['mt-6 font-display font-[600] tracking-[-0.035em] leading-none text-[clamp(2.4rem,5vw,3.4rem)]', c.status === 'result' ? 'text-navy-700' : 'text-gold-700']}>{(() => { const [lead, n] = roll(c.headlineStat) as [string, any]; return <>{lead}{n && <span class="tabular" data-count-to={n.to} data-count-from={n.from} data-suffix={n.suffix}>{n.to}{n.suffix}</span>}</>; })()}</div>
            <p class="mt-2 text-[16px] font-medium text-ink-900">{c.headlineLabel}</p>
          </div>
          <div class="lg:col-span-7 lg:self-center">
            <p class="text-[17px] leading-relaxed text-ink-900/90">{c.summary}</p>
            <ul class="mt-5 flex flex-wrap gap-2">
              {c.services.map((sv) => <li class="chip bg-cream-50 border border-stone-300 text-[14px]">{sv}</li>)}
            </ul>
            {c.note && <p class="mt-5 text-[13px] text-ink-600">{c.note}</p>}
          </div>
        </article>
      ))}
      <p class="text-[13.5px] text-ink-600 max-w-3xl">Every business and market is different. These are examples of what we delivered, not a promise of the same numbers for yours.</p>
    </div>
  </section>

  <Trades />
  <FinalCTA />
</Base>
