---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/sections/PageHero.astro';
import Trades from '@/components/sections/Trades.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';
import Icon from '@/components/ui/Icon.astro';
import { caseStudies } from '@/data/caseStudies';
---
<Base
  title="Results for Home Service Businesses | Palm Beach AI Services"
  description="Results for South Florida home service businesses: Safe Haven Inspections cut report time from 45 minutes to 10, and Hero's Pavers shows up in the Google map pack for more than 10 keywords. Plus AI consulting for a two-restaurant operator."
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Results', url: '/results/' }]}
>
  <PageHero compact eyebrow="Results" title="Results from local home service businesses."
    lede="Businesses we work with, and what changed for each one." />

  <section class="surface-cream py-12 sm:py-16">
    <div class="container-x space-y-6">
      {caseStudies.map((c) => (
        <article class="card rounded-[20px] p-7 sm:p-10 grid gap-8 lg:grid-cols-12 lg:gap-12">
          <div class="lg:col-span-5">
            {c.logo && <img src={c.logo.src} alt={`${c.client} logo`} width={c.logo.width} height={c.logo.height} class="mb-6 h-14 w-auto max-w-[240px] object-contain object-left" loading="lazy" decoding="async" />}
            <h2 class="h3 text-ink-900">{c.client}</h2>
            <p class="mt-1.5 text-[15px] text-ink-600">{c.trade} · {c.area}</p>
            <div class:list={['mt-6 font-display font-[600] tracking-[-0.035em] leading-none text-[clamp(2.4rem,5vw,3.4rem)]', c.status === 'result' ? 'text-navy-700' : 'text-gold-700']}>{c.headlineStat}</div>
            <p class="mt-2 text-[16px] font-medium text-ink-900">{c.headlineLabel}</p>
            <p class="mt-5 text-[16px] leading-relaxed text-ink-600">{c.summary}</p>
          </div>
          <div class="lg:col-span-7 grid gap-8 sm:grid-cols-2">
            <div>
              <h3 class="text-[15px] font-semibold text-ink-900">What we did</h3>
              <ul class="mt-3 space-y-2.5 text-[15.5px] text-ink-600">
                {c.whatWeDid.map((w) => <li class="flex gap-2.5"><Icon name="check" size={17} stroke={2.4} class="mt-[3px] shrink-0 text-navy-700" />{w}</li>)}
              </ul>
            </div>
            <div>
              <h3 class="text-[15px] font-semibold text-ink-900">{c.status === 'result' ? 'What changed' : 'Where it stands'}</h3>
              <ul class="mt-3 space-y-2.5 text-[15.5px] text-ink-600">
                {c.outcome.map((o) => <li class="flex gap-2.5"><Icon name="check" size={17} stroke={2.4} class="mt-[3px] shrink-0 text-navy-700" />{o}</li>)}
              </ul>
            </div>
            {c.stats.length > 0 && (
              <dl class="sm:col-span-2 grid grid-cols-3 gap-4 border-t border-stone-300 pt-6">
                {c.stats.map((s) => (
                  <div>
                    <dt class="font-display text-[22px] font-[600] tracking-tight text-ink-900 leading-tight">{s.value}</dt>
                    <dd class="mt-1 text-[13.5px] leading-snug text-ink-600">{s.label}</dd>
                  </div>
                ))}
              </dl>
            )}
            {c.note && <p class="sm:col-span-2 text-[13px] text-ink-600">{c.note}</p>}
          </div>
        </article>
      ))}
      <p class="text-[13.5px] text-ink-600 max-w-3xl">Every business and market is different. These are examples of what we delivered, not a promise of the same numbers for yours.</p>
    </div>
  </section>

  <Trades />
  <FinalCTA />
</Base>
