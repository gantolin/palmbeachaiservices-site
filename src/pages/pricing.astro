---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/sections/PageHero.astro';
import PricingPlan from '@/components/sections/PricingPlan.astro';
import CaseStudies from '@/components/sections/CaseStudies.astro';
import Guarantee from '@/components/sections/Guarantee.astro';
import Comparison from '@/components/sections/Comparison.astro';
import FAQ from '@/components/sections/FAQ.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';
import { pricingFaqs } from '@/data/faq';
import { plan, usd, priceLine } from '@/data/pricing';
---
<Base
  title={`Pricing: ${priceLine}, No Contract | Palm Beach AI Services`}
  description={`One simple plan: a ${usd(plan.buildFee)} one-time custom website build, then ${usd(plan.monthly)}/month for review automation, Google Business Profile management, lead follow-up, backlinks, competitor tracking, and a monthly check-in. Month-to-month. You own everything.`}
  faqs={pricingFaqs}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Pricing', url: '/pricing/' }]}
>
  <PageHero eyebrow="Pricing" title="One plan. Published *prices.*"
    lede={`${usd(plan.buildFee)} once for your custom website. Then ${usd(plan.monthly)} a month for everything that keeps the phone ringing. No tiers, no contract, and you own everything we build.`}
    crumbs={[{ name: 'Home', url: '/' }, { name: 'Pricing', url: '/pricing/' }]} center />

  <section class="surface-cream pt-16 pb-24 lg:pb-32" id="pricing">
    <div class="container-x">
      <h2 class="sr-only">The plan and what is included</h2>
      <PricingPlan />
    </div>
  </section>

  <CaseStudies surface="surface-sand" eyebrow="The proof behind the price" title="What that work looks like for *real* local businesses." lede="Exact numbers, with the math shown. No stock logos, no made-up stats." />
  <Guarantee />
  <Comparison />
  <FAQ faqs={pricingFaqs} title="Pricing *questions*" />
  <FinalCTA title="Not sure yet? Start with a free *teardown.*" />
</Base>
