---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/ui/Icon.astro';
import BookingEmbed from '@/components/islands/BookingEmbed.astro';
import { SITE, FOUNDER_FIRST_NAME, telHref } from '@/config/site';
import { words } from '@/lib/text';

const headline = 'Get found on Google. Get *hours back* every week.';

// Everything we do, in the two groups an owner cares about.
const groups = [
  {
    title: 'Get found on Google',
    items: [
      { name: 'Website', text: 'We build or fix your website so it shows up for your services in the towns you work in.' },
      { name: 'Google Business Profile', text: 'We set up and manage your profile so you show up on Google Maps.' },
      { name: 'Google reviews', text: 'Every finished job gets a review request by text.' },
    ],
  },
  {
    title: 'Get hours back with AI',
    items: [
      { name: 'Call answering', text: 'Calls get answered and missed calls get a text back while you are on a job.' },
      { name: 'Lead follow-up', text: 'New leads and open quotes get a text or an email until they book or say no.' },
      { name: 'Reports and paperwork', text: 'AI drafts your reports, estimates, and invoices.' },
      { name: 'Lead dashboard', text: 'Every lead and job in one place.' },
    ],
  },
];
---
<Base
  title="Local SEO & AI for Home Service Businesses | Palm Beach AI Services"
  description={`Get found on Google and get hours back with AI. Websites, Google Business Profile, reviews, call answering, and lead follow-up for home service businesses in Royal Palm Beach and Palm Beach County.`}
>
  <section class="relative overflow-hidden surface-dark grain -mt-px" id="services">
    <div class="hero-bloom absolute inset-0 glow-navy" aria-hidden="true"></div>
    <div class="container-x relative pt-10 pb-16 sm:pt-14 sm:pb-20">
      <div class="max-w-4xl">
        <div class="eyebrow fade-in">For home service businesses in Palm Beach County</div>
        <h1 class="display mt-5 text-[#f4f1e8] word-rise" set:html={words(headline)} />
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-2 fade-in" style="--d:300ms">
        {groups.map((g) => (
          <div class="rounded-[20px] bg-cream-50 p-6 sm:p-8">
            <h2 class="h3 text-ink-900">{g.title}</h2>
            <ul class="mt-5 space-y-4">
              {g.items.map((s) => (
                <li class="flex gap-3">
                  <Icon name="check" size={19} stroke={2.6} class="mt-[3px] shrink-0 text-navy-700" />
                  <p class="text-[16px] leading-snug text-ink-600"><span class="font-semibold text-ink-900">{s.name}.</span> {s.text}</p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="mt-9 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6 fade-in" style="--d:420ms">
        <a href="#book" class="btn btn-primary btn-lg btn-shine" data-magnetic>Book a free call<Icon name="arrow-right" size={18} /></a>
        <a href={telHref} class="inline-flex items-center gap-2 text-[16px] font-semibold text-mist-200 hover:text-white self-start sm:self-auto"><Icon name="phone" size={17} />or call {SITE.phone}</a>
      </div>
    </div>
  </section>

  <section class="section surface-dark border-t border-white/5" id="book">
    <div class="container-x">
      <div class="max-w-3xl mx-auto">
        <h2 class="h2 text-[#f4f1e8]">Book a free 30-minute call.</h2>
        <p class="lede mt-5">Pick a time below. {FOUNDER_FIRST_NAME} looks at your website and your Google profile before the call and tells you what to fix first. No contract, and nothing to sign.</p>
        <div class="mt-9">
          <BookingEmbed title="Book a free 30-minute call" />
        </div>
      </div>
    </div>
  </section>
</Base>
