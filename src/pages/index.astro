---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/ui/Icon.astro';
import Aurora from '@/components/ui/Aurora.astro';
import HeroPin from '@/components/ui/HeroPin.astro';
import BookingEmbed from '@/components/islands/BookingEmbed.astro';
import { SITE, FOUNDER_FIRST_NAME, telHref, smsHref } from '@/config/site';
import { words } from '@/lib/text';
import { serviceGroups as groups } from '@/data/offer';

const headline = 'Get found on Google. Get *hours back* every week.';
const callFacts = [
  { icon: 'clock', text: '30 minutes' },
  { icon: 'phone', text: 'Phone or video' },
  { icon: 'check', text: 'Free, nothing to sign' },
];
---
<Base
  title="Local SEO & AI for Local Businesses in Palm Beach County | Palm Beach AI Services"
  description={`Get found on Google and get hours back with AI. Websites, Google Business Profile, reviews, call answering, and lead follow-up for contractors, restaurants, medical offices, and other local businesses in Palm Beach County.`}
>
  <section class="relative overflow-hidden surface-dark grain -mt-px" id="services">
    <div class="hero-bloom absolute inset-0 glow-navy" aria-hidden="true"></div>
    <Aurora variant="soft" />
    <div class="absolute inset-x-0 bottom-0 h-px bg-[linear-gradient(90deg,transparent,rgba(230,205,131,.45),transparent)]" aria-hidden="true"></div>
    <div class="container-x hero-pad relative pt-10 pb-16 sm:pt-14 sm:pb-24">
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-14 lg:items-start">
        <div>
          <div class="hero-first">
          <div class="eyebrow fade-in">For local businesses in Palm Beach County</div>
          <div class="hero-head">
            <h1 class="h1 hero-h1 mt-5 text-[#f4f1e8] word-rise" set:html={words(headline)} />
            <div class="hero-art fade-in" style="--d:350ms"><HeroPin /></div>
          </div>
          <p class="mt-5 text-[19px] sm:text-[20px] leading-snug font-medium text-white max-w-[40ch] fade-in" style="--d:250ms">We build your website, manage your Google Business Profile, and use AI to automate the everyday work that eats your time.</p>
          <p class="hidden sm:block mt-3 text-[15.5px] leading-relaxed text-mist-400 max-w-[46ch] fade-in" style="--d:250ms">For contractors, restaurants, medical offices, and every other local business.</p>

          <div class="mt-7 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6 fade-in lg:hidden" style="--d:300ms">
            <a href="#book" class="btn btn-primary btn-lg btn-shine">Book a free audit<Icon name="arrow-right" size={18} /></a>
          </div>
          </div>

          <div class="mt-8 sm:mt-9 grid gap-4 sm:gap-5 fade-in" style="--d:300ms">
            {groups.map((g) => (
              <div class="service-card">
                <h2 class="h3 text-ink-900">{g.title}</h2>
                <ul class="mt-2 divide-y divide-stone-300/70">
                  {g.items.map((s) => (
                    <li class="flex items-start gap-4 py-3.5">
                      <span class="mt-0.5 size-9 shrink-0 rounded-[10px] bg-navy-700 text-gold-300 flex items-center justify-center"><Icon name={s.icon} size={17} /></span>
                      <p class="text-[16px] leading-snug text-ink-600"><span class="block font-semibold text-ink-900">{s.name}</span>{s.text}</p>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>

        <div id="book" class="book-card scroll-mt-28 fade-in" style="--d:200ms">
          <h2 class="h3 text-[#f4f1e8]">Book your free 30-minute audit.</h2>
          <p class="mt-3 text-[16px] leading-relaxed text-mist-400">Pick a time. {FOUNDER_FIRST_NAME} looks at your website and your Google profile before the call and tells you what to fix first.</p>
          <ul class="call-facts mt-5 flex flex-wrap gap-x-5 gap-y-2 text-[14.5px] text-mist-200">
            {callFacts.map((f) => <li class="inline-flex items-center gap-2"><Icon name={f.icon} size={16} class="text-gold-300" />{f.text}</li>)}
          </ul>
          <div class="mt-6">
            <BookingEmbed title="Book your free 30-minute audit" compact />
          </div>
          <div class="mt-5 hidden lg:grid gap-3 grid-cols-2">
            <a href={telHref} class="contact-pill"><Icon name="phone" size={19} class="text-gold-300" /><span><span class="block text-[12.5px] font-normal text-mist-400">Call</span>{SITE.phone}</span></a>
            <a href={smsHref} class="contact-pill"><Icon name="message" size={19} class="text-gold-300" /><span><span class="block text-[12.5px] font-normal text-mist-400">Text</span>{SITE.phone}</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // "Book a free audit" points at the calendar on this page. When the calendar is already on screen the
  // jump moves nothing, so light up its frame for a moment to show where to book.
  const book = document.getElementById('book');
  const flash = () => {
    if (!book) return;
    book.scrollIntoView({ block: 'nearest' });
    book.classList.add('is-flash');
    window.setTimeout(() => book.classList.remove('is-flash'), 2200);
  };
  document.addEventListener('click', (e) => {
    const a = (e.target as Element | null)?.closest?.('a[href$="#book"]');
    if (a) window.setTimeout(flash, 50);
  });
  if (location.hash === '#book') window.setTimeout(flash, 400);
</script>

<style>
  @media (min-width: 1024px) { .hero-h1 { font-size: clamp(2.4rem, 3.4vw, 3.1rem); } }

  /* Phones: the headline, sentence and button own the first screen. The block is as tall as the space
     between the top bar (76px) and the bottom bar (69px), so the white service cards start below it. */
  @media (max-width: 640px) { .hero-first { min-height: calc(100svh - 76px - 69px - 40px); display: flex; flex-direction: column; justify-content: center; padding-bottom: 20px; } }

  /* Map pin art to the right of the headline. The headline keeps clear of it by giving up that width. */
  .hero-head { position: relative; --art: clamp(84px, 24vw, 112px); }
  .hero-art { position: absolute; right: 0; top: 50%; width: var(--art); margin-top: 2px; transform: translateY(-50%); }
  .hero-head .hero-h1 { max-width: calc(100% - var(--art) - 14px); }
  @media (max-width: 640px) { .hero-head .hero-h1 { font-size: min(2.4rem, 9.8vw); } }
  @media (min-width: 641px) { .hero-head { --art: 140px; } }
  @media (min-width: 1024px) {
    .hero-head { --art: 112px; }
    .hero-head .hero-h1 { font-size: clamp(2.2rem, 2.9vw, 2.65rem); }
  }
  @media (min-width: 1280px) { .hero-head { --art: 140px; } }
  /* Very narrow or short phones: no room for the art without pushing the button off the first screen. */
  @media (max-width: 349px), (max-width: 640px) and (max-height: 600px) {
    .hero-art { display: none; }
    .hero-head .hero-h1 { max-width: none; }
  }
  /* Short phones: a smaller headline keeps the Book a free audit button above the bottom bar. */
  @media (max-width: 640px) and (max-height: 600px) { .hero-head .hero-h1 { font-size: 1.95rem; margin-top: 12px; } .hero-pad { padding-top: 24px; } }

  .service-card {
    border-radius: 22px; padding: 26px 28px 14px;
    background: linear-gradient(180deg, #fff, var(--color-cream-50));
    border: 1px solid rgba(255, 255, 255, .7);
    box-shadow: 0 30px 60px -36px rgba(0, 0, 0, .75), 0 1px 0 rgba(255, 255, 255, .9) inset;
  }

  /* The booking card: glass panel with a gold hairline, so the calendar reads as the main action. */
  .book-card {
    position: relative; border-radius: 28px; padding: 28px;
    background: linear-gradient(180deg, rgba(255, 255, 255, .09), rgba(255, 255, 255, .03));
    border: 1px solid rgba(230, 205, 131, .38);
    box-shadow: 0 50px 90px -45px rgba(0, 0, 0, .85), 0 0 70px -30px rgba(201, 162, 39, .35), 0 1px 0 rgba(255, 255, 255, .12) inset;
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    transition: border-color 300ms, box-shadow 300ms;
  }
  .book-card.is-flash {
    border-color: var(--color-gold-500);
    box-shadow: 0 50px 90px -45px rgba(0, 0, 0, .85), 0 0 0 4px rgba(201, 162, 39, .55), 0 0 90px -20px rgba(201, 162, 39, .7);
  }
  .book-card :global(.frame) { border-radius: 18px; box-shadow: 0 20px 40px -24px rgba(0, 0, 0, .6); }
  /* Phones: the calendar gets the full width of the page instead of sitting in a box inside a box,
     and the service cards tighten up so the list is quicker to read. */
  @media (max-width: 640px) {
    .book-card { padding: 28px 0 0; border: 0; border-top: 1px solid rgba(230, 205, 131, .3); border-radius: 0; background: none; box-shadow: none; backdrop-filter: none; -webkit-backdrop-filter: none; }
    .book-card.is-flash { box-shadow: none; }
    .book-card.is-flash :global(.frame) { box-shadow: 0 0 0 4px rgba(201, 162, 39, .7); }
    .book-card :global(h2) { font-size: 1.6rem; }
    .call-facts { display: grid; grid-template-columns: 1fr; gap: 8px; font-size: 15.5px; }
    .service-card { padding: 20px 20px 8px; border-radius: 20px; }
    .service-card :global(h2) { font-size: 1.3rem; }
    .service-card :global(li) { padding-top: 12px; padding-bottom: 12px; gap: 14px; }
  }

  .contact-pill {
    display: flex; align-items: center; gap: 12px; padding: 12px 18px; border-radius: 16px;
    font-size: 18px; font-weight: 600; letter-spacing: -0.01em; line-height: 1.2; color: #fff;
    background: rgba(255, 255, 255, .06); border: 1px solid rgba(255, 255, 255, .12);
    transition: background-color 200ms, border-color 200ms;
  }
  .contact-pill:hover { background: rgba(255, 255, 255, .1); border-color: rgba(230, 205, 131, .5); }
</style>
