---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/ui/Icon.astro';
import Aurora from '@/components/ui/Aurora.astro';
import HeroPin from '@/components/ui/HeroPin.astro';
import Sonar from '@/components/ui/Sonar.astro';
import BookingEmbed from '@/components/islands/BookingEmbed.astro';
import { SITE, telHref, smsHref } from '@/config/site';
import { words } from '@/lib/text';
import { serviceGroups as groups } from '@/data/offer';

const headline = 'Get found on Google. Get *hours back* every week.';
/** Matches the Google Business Profile: primary category (Marketing agency), main services, and city. */
const kicker = 'SEO and AI marketing agency in Royal Palm Beach, FL';
const callFacts = [
  { icon: 'clock', text: '30 minutes' },
  { icon: 'phone', text: 'Phone or video' },
  { icon: 'check', text: 'Free, nothing to sign' },
];
---
<Base
  title="Local SEO & AI for Businesses in Palm Beach County, FL"
  description="Get found on Google and get hours back with AI. Websites, Google Business Profile, reviews, and lead follow-up for local businesses in Palm Beach County."
>
  <section class="relative overflow-hidden surface-dark grain -mt-px" id="services">
    <div class="hero-bloom absolute inset-0 glow-navy" aria-hidden="true"></div>
    <Aurora variant="soft" />
    <Sonar origin=".hero-art .tile" />
    <div class="absolute inset-x-0 bottom-0 h-px bg-[linear-gradient(90deg,transparent,rgba(230,205,131,.45),transparent)]" aria-hidden="true"></div>
    <div class="container-x hero-pad relative pt-6 pb-16 sm:pt-10 sm:pb-24">
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-14 lg:items-start">
        <div>
          <div class="hero-first">
          <div class="hero-head">
            {/* One H1: the line Google needs (what we are, where) and the line owners read. */}
            <h1>
              <span class="eyebrow hero-kicker fade-in">{kicker}</span>
              <span class="h1 hero-h1 block mt-5 text-[#f4f1e8] word-rise" set:html={words(headline)} />
            </h1>
            <div class="hero-art fade-in" style="--d:350ms"><HeroPin /></div>
          </div>
          <p class="mt-5 text-[19px] sm:text-[20px] leading-snug font-medium text-white max-w-[40ch] fade-in" style="--d:250ms">We build your website, manage your Google Business Profile, and use AI to automate the everyday work that eats your time.</p>
          <p class="hidden sm:block mt-3 text-[15.5px] leading-relaxed text-mist-400 max-w-[46ch] fade-in" style="--d:250ms">For contractors, restaurants, medical offices, and every other local business.</p>

          <div class="mt-7 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6 fade-in lg:hidden" style="--d:300ms">
            <a href="#book" class="btn btn-primary btn-lg btn-shine">Book a free audit<Icon name="arrow-right" size={18} /></a>
          </div>
          </div>

          <div class="mt-8 sm:mt-9 grid gap-4 sm:gap-5 fade-in" style="--d:300ms">
            {groups.map((g, gi) => (
              <div class="service-card" data-trail>
                {gi === 0 ? (
                  /* Found on Google: a map with "Your business" at the top of the local results. */
                  <div class="viz viz-map" aria-hidden="true">
                    <svg viewBox="0 0 400 130" preserveAspectRatio="xMidYMid slice">
                      <rect width="400" height="130" fill="#0b2a50" />
                      <path d="M318 0C306 34 334 72 320 130H400V0Z" fill="#12467f" />
                      <rect x="214" y="14" width="46" height="30" rx="7" fill="#12553f" opacity=".7" />
                      <ellipse cx="250" cy="112" rx="34" ry="14" fill="#12553f" opacity=".7" />
                      <g fill="none" stroke="rgba(255,255,255,.14)" stroke-width="3" stroke-linecap="round">
                        <path d="M150 52H318" /><path d="M196 -4V134" /><path d="M276 -4V134" /><path d="M150 100L318 88" /><path d="M236 52V96" />
                      </g>
                      <path d="M150 74H322" fill="none" stroke="#c9a227" stroke-width="3.5" stroke-linecap="round" opacity=".9" />
                    </svg>
                    <span class="viz-ring"></span>
                    <svg class="viz-pin" viewBox="0 0 24 24"><path d="M12 2C7.6 2 4 5.6 4 10c0 6 8 12 8 12s8-6 8-12c0-4.4-3.6-8-8-8z" fill="#ea4335" /><circle cx="12" cy="10" r="3.2" fill="#fff" /></svg>
                    <div class="viz-pack">
                      <div class="viz-top"><span class="viz-rank">1</span><span class="viz-biz">Your business</span></div>
                      <div class="viz-bar" style="width:78%"></div>
                      <div class="viz-bar" style="width:60%"></div>
                    </div>
                  </div>
                ) : (
                  /* Hours back: the jobs the AI finishes, ticking off one after another. */
                  <div class="viz viz-auto" aria-hidden="true">
                    {['New lead followed up', 'Review request sent', 'Estimate drafted'].map((t, i) => (
                      <div class="viz-done" style={`--n:${i}`}><span class="viz-check"><Icon name="check" size={13} stroke={3} /></span>{t}</div>
                    ))}
                  </div>
                )}
                <h2 class="h3 mt-5 text-[#f4f1e8]">{g.title}</h2>
                <ul class="trail mt-2 divide-y divide-white/10">
                  {g.items.map((s) => (
                    <li class="trail-row flex items-start gap-4 py-3.5">
                      <span class="trail-dot mt-0.5 size-9 shrink-0 rounded-[10px] flex items-center justify-center"><Icon name={s.icon} size={17} /></span>
                      <p class="trail-text text-[16px] leading-snug text-mist-400"><span class="block font-semibold text-[#f4f1e8]">{s.name}</span>{s.text}</p>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>

        <div id="book" class="book-card scroll-mt-28 fade-in" style="--d:200ms">
          <h2 class="h3 text-[#f4f1e8]">Book your free 30-minute audit.</h2>
          <p class="mt-3 text-[16px] leading-relaxed text-mist-400">Pick a time. We look at your website and your Google profile before the call and tell you what to fix first.</p>
          <ul class="call-facts mt-5 flex flex-wrap gap-x-5 gap-y-2 text-[14.5px] text-mist-200">
            {callFacts.map((f) => <li class="inline-flex items-center gap-2"><Icon name={f.icon} size={16} class="text-gold-300" />{f.text}</li>)}
          </ul>
          <div class="mt-6">
            <BookingEmbed title="Book your free 30-minute audit" compact />
          </div>
          <div class="mt-5 hidden lg:grid gap-3 grid-cols-2">
            <a href={telHref} class="contact-pill"><Icon name="phone" size={19} class="text-gold-300" /><span><span class="block text-[12.5px] font-normal text-mist-400">Call</span>{SITE.phone}</span></a>
            <a href={smsHref} class="contact-pill"><Icon name="message" size={19} class="text-gold-300" /><span><span class="block text-[12.5px] font-normal text-mist-400">Text</span>{SITE.phone}</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // "Book a free audit" points at the calendar on this page. When the calendar is already on screen the
  // jump moves nothing, so light up its frame for a moment to show where to book.
  const book = document.getElementById('book');
  const flash = () => {
    if (!book) return;
    book.scrollIntoView({ block: 'nearest' });
    book.classList.add('is-flash');
    window.setTimeout(() => book.classList.remove('is-flash'), 2200);
  };
  document.addEventListener('click', (e) => {
    const a = (e.target as Element | null)?.closest?.('a[href$="#book"]');
    if (a) window.setTimeout(flash, 50);
  });
  if (location.hash === '#book') window.setTimeout(flash, 400);

  // A gold line runs down each service card and each service lights up when the line reaches it (and
  // stays lit). Without this script the cards simply show fully lit.
  const trailCards = Array.from(document.querySelectorAll<HTMLElement>('[data-trail]'));
  if (trailCards.length) {
    const state = trailCards.map((card) => {
      const list = card.querySelector<HTMLElement>('.trail')!;
      const rows = Array.from(card.querySelectorAll<HTMLElement>('.trail-row'));
      card.classList.add('trail-on');
      return { card, list, rows, top: 0, len: 0, centers: [] as number[], best: -1 };
    });
    const measure = () => state.forEach((st) => {
      const lb = st.list.getBoundingClientRect();
      st.centers = st.rows.map((r) => { const d = r.querySelector('.trail-dot')!.getBoundingClientRect(); return d.top + d.height / 2 - lb.top; });
      st.top = st.centers[0];
      st.len = st.centers[st.centers.length - 1] - st.top;
      st.list.style.setProperty('--trail-top', `${st.top}px`);
      st.list.style.setProperty('--trail-len', `${st.len}px`);
    });
    const paint = (st: (typeof state)[number]) => {
      st.list.style.setProperty('--trail-fill', st.len ? (Math.max(0, st.best) / st.len).toFixed(4) : '0');
      st.rows.forEach((r, i) => r.classList.toggle('is-lit', st.best >= 0 && st.centers[i] - st.top <= st.best + 2));
    };
    // The line follows the scroll on every screen size: each service lights up as it comes up the
    // screen. The tip sits low (80% down), so a service lights soon after it appears.
    let queued = false;
    const update = () => {
      queued = false;
      const line = window.innerHeight * 0.8;
      state.forEach((st) => {
        const y = st.list.getBoundingClientRect().top + st.top;
        st.best = Math.max(st.best, Math.min(st.len, line - y));   // only ever grows
        paint(st);
      });
    };
    measure(); update();
    window.addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
    window.addEventListener('resize', () => { measure(); update(); });
    window.setTimeout(() => { measure(); update(); }, 1500);   // fonts and the headline animation settle
  }
</script>

<style>
  @media (min-width: 1024px) { .hero-h1 { font-size: clamp(2.4rem, 3.4vw, 3.1rem); } }

  /* Phones: the headline, sentence and button own the first screen. The block is as tall as the space
     between the top bar (84px) and the bottom bar (69px), so the white service cards start below it. */
  @media (max-width: 640px) { .hero-first { min-height: calc(100svh - 84px - 69px - 40px); display: flex; flex-direction: column; justify-content: flex-start; padding-bottom: 20px; } }

  /* "hours back" gets a marker stroke: a gold bar swipes in behind the words, which turn navy on it.
     This replaces the gold shimmer text the other dark heroes use. */
  .hero-head .hero-h1 :global(.accent) {
    position: relative; z-index: 0; display: inline-block; padding: 0 .14em; margin: 0 -.06em;
    background: none; -webkit-background-clip: border-box; background-clip: border-box;
    color: var(--color-navy-950); animation: none;
  }
  .hero-head .hero-h1 :global(.accent)::before {
    content: ""; position: absolute; z-index: -1; inset: .1em 0 .02em; border-radius: .16em;
    /* Top layer is the same white sheen the Book a free audit button has; it sweeps across on the same beat. */
    background:
      linear-gradient(108deg, rgba(255, 255, 255, 0) 42%, rgba(255, 255, 255, .6) 50%, rgba(255, 255, 255, 0) 58%) 160% 0 / 260% 100% no-repeat,
      linear-gradient(100deg, #c9a227, #e2c25a 55%, #c9a227);
    transform: scaleX(0); transform-origin: 0 50%;
    animation: marker 520ms cubic-bezier(.3, .8, .3, 1) 900ms forwards, marker-shine 6s var(--ease-out-soft) 1.8s infinite;
  }
  @keyframes marker { to { transform: scaleX(1); } }
  @media (prefers-reduced-motion: reduce) {
    .hero-head .hero-h1 :global(.accent)::before { animation-duration: 520ms, 6s !important; animation-iteration-count: 1, infinite !important; }
    .book-card::before, .book-card :global(.frame)::after { animation-duration: 7s !important; animation-iteration-count: infinite !important; }
  }
  @keyframes marker-shine { 0% { background-position: 160% 0, 0 0; } 22%, 100% { background-position: -60% 0, 0 0; } }

  /* Map pin art to the right of the headline. The headline keeps clear of it by giving up that width. */
  .hero-head { position: relative; --art: clamp(84px, 24vw, 112px); --kick: 64px; }
  .hero-kicker { display: block; letter-spacing: 0; line-height: 1.4; }
  /* Centered on the big headline, not on the small line above it (--kick is that line's height). */
  .hero-art { position: absolute; right: 0; top: 50%; width: var(--art); margin-top: calc(var(--kick) / 2); transform: translateY(-50%); }
  .hero-head .hero-h1 { max-width: calc(100% - var(--art) - 14px); }
  @media (max-width: 640px) { .hero-head .hero-h1 { font-size: min(2.6rem, 10.25vw); } }
  @media (min-width: 641px) { .hero-head { --art: 140px; --kick: 42px; } }
  @media (min-width: 1024px) {
    .hero-head { --art: 112px; }
    .hero-head .hero-h1 { font-size: clamp(2.3rem, 3.05vw, 2.75rem); }
  }
  @media (min-width: 1280px) { .hero-head { --art: 140px; } }
  /* Very narrow or short phones: no room for the art without pushing the button off the first screen. */
  @media (max-width: 349px), (max-width: 640px) and (max-height: 600px) {
    .hero-art { display: none; }
    .hero-head .hero-h1 { max-width: none; }
  }
  /* Short phones: a smaller headline keeps the Book a free audit button above the bottom bar. */
  @media (max-width: 640px) and (max-height: 600px) { .hero-head .hero-h1 { font-size: 1.95rem; margin-top: 12px; } .hero-pad { padding-top: 24px; } }

  /* Service cards: dark glass like the booking card, each with its own picture on top. */
  .service-card {
    border-radius: 24px; padding: 18px 22px 10px;
    background: linear-gradient(180deg, rgba(255, 255, 255, .09), rgba(255, 255, 255, .03));
    border: 1px solid rgba(230, 205, 131, .3);
    box-shadow: 0 40px 70px -40px rgba(0, 0, 0, .85), 0 1px 0 rgba(255, 255, 255, .1) inset;
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
  }
  .viz { position: relative; height: 132px; border-radius: 14px; overflow: hidden; border: 1px solid rgba(255, 255, 255, .1); }
  .viz > svg:first-child { position: absolute; inset: 0; width: 100%; height: 100%; }

  /* Picture 1: the map, with "Your business" first in the list. */
  .viz-pin { position: absolute; left: 68%; top: 56%; width: 40px; transform: translate(-50%, -100%); filter: drop-shadow(0 5px 5px rgba(0, 0, 0, .45)); }
  .viz-ring { position: absolute; left: 68%; top: 56%; width: 30px; aspect-ratio: 2.4; border-radius: 50%; transform: translate(-50%, -50%); border: 2px solid rgba(234, 67, 53, .85); animation: viz-ring 2.4s ease-out infinite; }
  @keyframes viz-ring { 0% { opacity: .9; transform: translate(-50%, -50%) scale(.6); } 100% { opacity: 0; transform: translate(-50%, -50%) scale(2.6); } }
  .viz-pack { position: absolute; left: 12px; top: 50%; width: min(46%, 190px); transform: translateY(-50%); display: grid; gap: 7px; }
  .viz-top { display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-radius: 10px; background: #fff; color: #0b2a50; font: 700 14px/1.1 var(--font-sans); box-shadow: 0 0 0 2px var(--color-gold-500), 0 10px 22px -8px rgba(0, 0, 0, .7); white-space: nowrap; }
  .viz-rank { width: 20px; height: 20px; border-radius: 50%; flex: none; display: flex; align-items: center; justify-content: center; background: var(--color-gold-500); color: #0b2a50; font-size: 12px; }
  .viz-bar { height: 12px; border-radius: 6px; background: rgba(255, 255, 255, .16); }

  /* Picture 2: finished jobs ticking off, one after another, on a loop. */
  .viz-auto { display: grid; align-content: center; gap: 8px; padding: 0 14px; background: radial-gradient(120% 140% at 100% 0%, #12467f 0%, #0b2a50 45%, #061f3f 100%); }
  .viz-done { display: flex; align-items: center; gap: 9px; width: fit-content; padding: 6px 12px 6px 7px; border-radius: 999px; background: rgba(255, 255, 255, .1); border: 1px solid rgba(255, 255, 255, .14); color: #f4f1e8; font: 600 13.5px/1.1 var(--font-sans); animation: viz-done 7.5s cubic-bezier(.22, 1, .36, 1) calc(var(--n) * .9s + .4s) infinite backwards; }
  .viz-done:nth-child(2) { margin-left: 22px; }
  .viz-done:nth-child(3) { margin-left: 44px; }
  .viz-check { width: 20px; height: 20px; border-radius: 50%; flex: none; display: flex; align-items: center; justify-content: center; background: var(--color-gold-500); color: #0b2a50; }
  @keyframes viz-done { 0% { opacity: 0; transform: translateY(10px); } 7%, 86% { opacity: 1; transform: none; } 94%, 100% { opacity: 0; transform: translateY(-6px); } }
  @media (prefers-reduced-motion: reduce) {
    .viz-ring { animation-duration: 2.4s !important; animation-iteration-count: infinite !important; }
    .viz-done { animation-duration: 7.5s !important; animation-iteration-count: infinite !important; }
  }

  /* Service trail (see the script above). The track and the gold fill sit behind the icons; a row is
     dim until the fill reaches its icon. Rows with no script running show in the lit colors. */
  .trail { position: relative; }
  .service-card.trail-on .trail::before, .service-card.trail-on .trail::after {
    content: ""; position: absolute; left: 17px; top: var(--trail-top, 0); width: 2px; height: var(--trail-len, 0); border-radius: 2px;
  }
  .service-card.trail-on .trail::before { background: rgba(255, 255, 255, .1); }
  .service-card.trail-on .trail::after {
    background: linear-gradient(180deg, #e2c25a, #c9a227); transform-origin: 50% 0; transform: scaleY(var(--trail-fill, 0));
    transition: transform 260ms linear; box-shadow: 0 0 10px rgba(201, 162, 39, .55);
  }
  .trail-dot { position: relative; z-index: 1; background: var(--color-gold-500); color: var(--color-navy-950); }
  .service-card.trail-on .trail-dot { background: #1b3557; color: #8ea9cb; transition: background-color 300ms, color 300ms, box-shadow 300ms; }
  .service-card.trail-on .trail-text { opacity: .42; transform: translateX(6px); transition: opacity 400ms, transform 400ms cubic-bezier(.22, 1, .36, 1); }
  .service-card.trail-on .is-lit .trail-dot {
    background: var(--color-gold-500); color: var(--color-navy-950);
    box-shadow: 0 0 0 3px rgba(201, 162, 39, .25), 0 0 18px -2px rgba(201, 162, 39, .7);
    animation: trail-pop 420ms cubic-bezier(.3, 1.6, .5, 1);
  }
  .service-card.trail-on .is-lit .trail-text { opacity: 1; transform: none; }
  @keyframes trail-pop { 0% { transform: scale(.82); } 60% { transform: scale(1.14); } 100% { transform: scale(1); } }
  /* Runs with reduced motion too: it only moves when the visitor scrolls. */
  @media (prefers-reduced-motion: reduce) {
    .service-card.trail-on .trail::after { transition-duration: 260ms !important; }
    .service-card.trail-on .trail-dot { transition-duration: 300ms !important; }
    .service-card.trail-on .trail-text { transition-duration: 400ms !important; }
    .service-card.trail-on .is-lit .trail-dot { animation-duration: 420ms !important; }
  }

  /* The booking card: glass panel with a gold hairline, so the calendar reads as the main action. */
  .book-card {
    position: relative; border-radius: 28px; padding: 28px;
    background: linear-gradient(180deg, rgba(255, 255, 255, .09), rgba(255, 255, 255, .03));
    border: 1px solid rgba(230, 205, 131, .38);
    box-shadow: 0 50px 90px -45px rgba(0, 0, 0, .85), 0 0 70px -30px rgba(201, 162, 39, .35), 0 1px 0 rgba(255, 255, 255, .12) inset;
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    transition: border-color 300ms, box-shadow 300ms;
  }
  /* A small gold light circles the card's edge to draw the eye to the calendar. Tablet and up only:
     on phones the calendar has no card around it. */
  @property --beam { syntax: "<angle>"; inherits: false; initial-value: 0deg; }
  @media (min-width: 641px) {
    .book-card::before {
      content: ""; position: absolute; inset: -1px; border-radius: inherit; padding: 2px; pointer-events: none;
      background: conic-gradient(from var(--beam), transparent 0 78%, rgba(201, 162, 39, .9) 90%, #fff3c4 96%, transparent 100%);
      -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor;
      mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
      animation: beam 7s linear infinite;
    }
  }
  /* Phones: the calendar has no card around it, so the light runs around the white calendar itself. */
  @media (max-width: 640px) {
    .book-card :global(.frame) { position: relative; box-shadow: 0 0 0 1px rgba(201, 162, 39, .55), 0 20px 40px -24px rgba(0, 0, 0, .6); }
    .book-card :global(.frame)::after {
      content: ""; position: absolute; inset: 0; border-radius: inherit; padding: 3px; pointer-events: none;
      background: conic-gradient(from var(--beam), transparent 0 74%, rgba(226, 194, 90, .95) 88%, #b8860b 96%, transparent 100%);
      -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor;
      mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
      animation: beam 7s linear infinite;
    }
  }
  @keyframes beam { to { --beam: 360deg; } }
  .book-card.is-flash {
    border-color: var(--color-gold-500);
    box-shadow: 0 50px 90px -45px rgba(0, 0, 0, .85), 0 0 0 4px rgba(201, 162, 39, .55), 0 0 90px -20px rgba(201, 162, 39, .7);
  }
  .book-card :global(.frame) { border-radius: 18px; box-shadow: 0 20px 40px -24px rgba(0, 0, 0, .6); }
  /* Phones: the calendar gets the full width of the page instead of sitting in a box inside a box,
     and the service cards tighten up so the list is quicker to read. */
  @media (max-width: 640px) {
    .book-card { padding: 28px 0 0; border: 0; border-top: 1px solid rgba(230, 205, 131, .3); border-radius: 0; background: none; box-shadow: none; backdrop-filter: none; -webkit-backdrop-filter: none; }
    /* A small gold light circles the card's edge to draw the eye to the calendar. Tablet and up only:
     on phones the calendar has no card around it. */
  @property --beam { syntax: "<angle>"; inherits: false; initial-value: 0deg; }
  @media (min-width: 641px) {
    .book-card::before {
      content: ""; position: absolute; inset: -1px; border-radius: inherit; padding: 2px; pointer-events: none;
      background: conic-gradient(from var(--beam), transparent 0 78%, rgba(201, 162, 39, .9) 90%, #fff3c4 96%, transparent 100%);
      -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor;
      mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
      animation: beam 7s linear infinite;
    }
  }
  /* Phones: the calendar has no card around it, so the light runs around the white calendar itself. */
  @media (max-width: 640px) {
    .book-card :global(.frame) { position: relative; box-shadow: 0 0 0 1px rgba(201, 162, 39, .55), 0 20px 40px -24px rgba(0, 0, 0, .6); }
    .book-card :global(.frame)::after {
