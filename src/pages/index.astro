---
import Base from '@/layouts/Base.astro';
import HomeHero from '@/components/sections/HomeHero.astro';
import Founder from '@/components/sections/Founder.astro';
import FAQ from '@/components/sections/FAQ.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';
import { homeFaqs } from '@/data/faq';
import { FOUNDER_FIRST_NAME } from '@/config/site';

// One outcome, three parts. These are how the work gets done, not separate offers, so they do not link out.
const steps = [
  {
    name: 'Show up',
    text: 'We build or fix your website and your Google Business Profile around the services you sell and the towns you work in. When a homeowner nearby searches for your trade, you are one of the companies they see.',
  },
  {
    name: 'Answer',
    text: 'A missed call gets a text back within seconds. After hours, the phone is answered, the details are taken, and the visit is booked. New leads and open quotes get a follow-up until they book or say no.',
  },
  {
    name: 'Get the time back',
    text: 'Every trade has reports, estimates, and office work that eat the evenings. We build AI around the paperwork your trade already does, so it is drafted for you and you only have to review it.',
  },
];
---
<Base
  title="Local SEO & AI for Home Service Businesses | Palm Beach AI Services"
  description={`More booked jobs and less time on the phone and paperwork for Palm Beach County home service businesses. Website, Google Business Profile, and lead follow-up, handled by ${FOUNDER_FIRST_NAME}. Month to month.`}
  faqs={homeFaqs}
>
  <HomeHero />

  <section class="section surface-cream" id="how">
    <div class="container-x">
      <div class="max-w-3xl" data-reveal>
        <div class="eyebrow">What you get</div>
        <h2 class="h2 mt-5">More booked jobs. Less time on the phone and the paperwork.</h2>
      </div>
      <ol class="mt-12 grid gap-5 md:grid-cols-3">
        {steps.map((s, i) => (
          <li class="card flex flex-col p-7 sm:p-8 rounded-[20px]" data-reveal style={`--d:${i * 70}ms`}>
            <span class="inline-flex size-10 items-center justify-center rounded-full bg-navy-700 text-white text-[17px] font-semibold" aria-hidden="true">{i + 1}</span>
            <h3 class="h3 mt-5">{s.name}</h3>
            <p class="mt-3 text-[16px] text-ink-900/90">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="surface-sand py-10 sm:py-12" id="proof">
    <div class="container-x">
      <p class="text-center font-display text-[clamp(1.15rem,2vw,1.5rem)] font-[600] tracking-tight text-ink-900" data-reveal>Built for Palm Beach County home service companies.</p>
    </div>
  </section>

  <FinalCTA
    eyebrow="Free 30-minute audit call"
    title="Start with a free audit."
    text="We'll look at your Google profile and your site next to the three companies above you, and tell you what to fix first. You keep the list either way."
    ctaLabel="Book the free audit call"
    only
  />

  <Founder home />
  <FAQ faqs={homeFaqs} title="Common *questions.*" />
</Base>
