---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/ui/Icon.astro';
import Aurora from '@/components/ui/Aurora.astro';
import BookingEmbed from '@/components/islands/BookingEmbed.astro';
import { SITE, FOUNDER_FIRST_NAME, telHref, smsHref } from '@/config/site';
import { words } from '@/lib/text';
import { serviceGroups as groups } from '@/data/offer';

const headline = 'Get found on Google. Get *hours back* every week.';
/** What a customer types. Shown in the search bar above the headline. */
const searches = ['plumber near me', 'best restaurant near me', 'doctor near me', 'roofer in West Palm Beach', 'house cleaner near me'];
const callFacts = [
  { icon: 'clock', text: '30 minutes' },
  { icon: 'phone', text: 'Phone or video' },
  { icon: 'check', text: 'Free, nothing to sign' },
];
---
<Base
  title="Local SEO & AI for Local Businesses in Palm Beach County | Palm Beach AI Services"
  description={`Get found on Google and get hours back with AI. Websites, Google Business Profile, reviews, call answering, and lead follow-up for contractors, restaurants, medical offices, and other local businesses in Palm Beach County.`}
>
  <section class="relative overflow-hidden surface-dark grain -mt-px" id="services">
    <div class="hero-bloom absolute inset-0 glow-navy" aria-hidden="true"></div>
    <Aurora variant="soft" />
    <div class="absolute inset-x-0 bottom-0 h-px bg-[linear-gradient(90deg,transparent,rgba(230,205,131,.45),transparent)]" aria-hidden="true"></div>
    <div class="container-x relative pt-10 pb-16 sm:pt-14 sm:pb-24">
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-14 lg:items-start">
        <div>
          <!-- The hero copy sits inside a search page: the search someone types, and this business as the top result. -->
          <div class="search-frame fade-in">
            <div class="search-top" aria-hidden="true">
              <div class="search-bar">
                <Icon name="search" size={18} class="search-glass" />
                <span class="search-query" data-queries={JSON.stringify(searches)}>{searches[0]}</span><span class="search-caret"></span>
                <span class="search-dots"><i></i><i></i><i></i><i></i></span>
              </div>
              <div class="search-tabs"><span class="on">All</span><span>Maps</span><span>Reviews</span><span>Images</span></div>
            </div>
            <div class="search-result">
              <div class="result-site" aria-hidden="true">
                <span class="result-icon"><Icon name="pin" size={16} /></span>
                <span><span class="block text-[14px] font-medium text-ink-900 leading-tight">{SITE.name}</span><span class="block text-[12.5px] text-ink-600 leading-tight">{SITE.domain}</span></span>
              </div>
              <div class="eyebrow mt-4">For local businesses in Palm Beach County</div>
              <h1 class="h1 hero-h1 mt-2 word-rise" set:html={words(headline)} />
              <p class="mt-4 text-[18px] sm:text-[19px] leading-snug font-medium text-ink-900 max-w-[40ch]">We build your website, manage your Google Maps listing, and use AI to automate the everyday work that eats your time, like following up with leads.</p>
              <p class="hidden sm:block mt-3 text-[15.5px] leading-relaxed text-ink-600 max-w-[46ch]">For contractors, restaurants, medical offices, and every other local business.</p>
              <div class="mt-6 lg:hidden">
                <a href="#book" class="btn btn-primary btn-lg btn-shine w-full sm:w-auto">Book a free audit<Icon name="arrow-right" size={18} /></a>
              </div>
            </div>
          </div>

          <div class="mt-9 grid gap-5 fade-in" style="--d:300ms">
            {groups.map((g) => (
              <div class="service-card">
                <h2 class="h3 text-ink-900">{g.title}</h2>
                <ul class="mt-2 divide-y divide-stone-300/70">
                  {g.items.map((s) => (
                    <li class="flex items-start gap-4 py-3.5">
                      <span class="mt-0.5 size-9 shrink-0 rounded-[10px] bg-navy-700 text-gold-300 flex items-center justify-center"><Icon name={s.icon} size={17} /></span>
                      <p class="text-[16px] leading-snug text-ink-600"><span class="block font-semibold text-ink-900">{s.name}</span>{s.text}</p>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>

        <div id="book" class="book-card scroll-mt-28 fade-in" style="--d:200ms">
          <h2 class="h3 text-[#f4f1e8]">Book your free 30-minute audit.</h2>
          <p class="mt-3 text-[16px] leading-relaxed text-mist-400">Pick a time. {FOUNDER_FIRST_NAME} looks at your website and your Google profile before the call and tells you what to fix first.</p>
          <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-[14.5px] text-mist-200">
            {callFacts.map((f) => <li class="inline-flex items-center gap-2"><Icon name={f.icon} size={16} class="text-gold-300" />{f.text}</li>)}
          </ul>
          <div class="mt-6">
            <BookingEmbed title="Book your free 30-minute audit" compact />
          </div>
          <div class="mt-5 grid gap-3 sm:grid-cols-2">
            <a href={telHref} class="contact-pill"><Icon name="phone" size={19} class="text-gold-300" /><span><span class="block text-[12.5px] font-normal text-mist-400">Call</span>{SITE.phone}</span></a>
            <a href={smsHref} class="contact-pill"><Icon name="message" size={19} class="text-gold-300" /><span><span class="block text-[12.5px] font-normal text-mist-400">Text</span>{SITE.phone}</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // "Book a free audit" points at the calendar on this page. When the calendar is already on screen the
  // jump moves nothing, so light up its frame for a moment to show where to book.
  const book = document.getElementById('book');
  const flash = () => {
    if (!book) return;
    book.scrollIntoView({ block: 'nearest' });
    book.classList.add('is-flash');
    window.setTimeout(() => book.classList.remove('is-flash'), 2200);
  };
  document.addEventListener('click', (e) => {
    const a = (e.target as Element | null)?.closest?.('a[href$="#book"]');
    if (a) window.setTimeout(flash, 50);
  });
  if (location.hash === '#book') window.setTimeout(flash, 400);

  // Type the searches into the search bar, one after another. This runs even with reduced motion set:
  // it is a few characters of text changing in place, and Gene's own PC has that setting on.
  const q = document.querySelector<HTMLElement>('.search-query');
  if (q) {
    const list: string[] = JSON.parse(q.dataset.queries ?? '[]');
    let n = 0;
    const type = (text: string, i: number) => {
      q.textContent = text.slice(0, i);
      if (i < text.length) window.setTimeout(() => type(text, i + 1), 65);
      else window.setTimeout(() => erase(text, text.length), 2200);
    };
    const erase = (text: string, i: number) => {
      q.textContent = text.slice(0, i);
      if (i > 0) window.setTimeout(() => erase(text, i - 1), 28);
      else { n = (n + 1) % list.length; window.setTimeout(() => type(list[n], 1), 350); }
    };
    if (list.length > 1) window.setTimeout(() => erase(list[0], list[0].length), 2600);
  }
</script>

<style>
  @media (min-width: 1024px) { .hero-h1 { font-size: clamp(2.4rem, 3.4vw, 3.1rem); } }

  /* Search page frame around the hero copy. */
  .search-frame {
    border-radius: 24px; overflow: hidden; background: #fff;
    border: 1px solid rgba(255, 255, 255, .7);
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, .8), 0 0 70px -34px rgba(66, 133, 244, .55);
  }
  .search-top { padding: 18px 22px 0; border-bottom: 1px solid #e6e8ec; }
  .search-bar {
    display: flex; align-items: center; gap: 10px; height: 48px; padding: 0 16px 0 18px; border-radius: 999px;
    background: #fff; border: 1px solid #dfe1e5; box-shadow: 0 2px 8px -2px rgba(32, 33, 36, .22);
    font-size: 16px; color: #202124; white-space: nowrap; overflow: hidden;
  }
  .search-bar :global(.search-glass) { color: #4285f4; flex: none; }
  .search-caret { width: 1.5px; height: 20px; margin-left: -8px; background: #202124; animation: caret 1.1s steps(1) infinite; }
  @keyframes caret { 50% { opacity: 0; } }
  .search-dots { margin-left: auto; display: flex; gap: 5px; flex: none; }
  .search-dots i { width: 8px; height: 8px; border-radius: 50%; }
  .search-dots i:nth-child(1) { background: #4285f4; }
  .search-dots i:nth-child(2) { background: #ea4335; }
  .search-dots i:nth-child(3) { background: #fbbc05; }
  .search-dots i:nth-child(4) { background: #34a853; }
  .search-tabs { display: flex; gap: 22px; margin-top: 12px; padding: 0 6px; font-size: 14px; color: #5f6368; }
  .search-tabs span { padding-bottom: 9px; border-bottom: 3px solid transparent; }
  .search-tabs .on { color: #1a73e8; border-bottom-color: #1a73e8; font-weight: 500; }
  .search-result { padding: 20px 24px 26px; }
  .result-site { display: flex; align-items: center; gap: 10px; }
  .result-icon { width: 30px; height: 30px; border-radius: 50%; flex: none; display: flex; align-items: center; justify-content: center; background: var(--color-navy-700); color: var(--color-gold-300); }
  .search-frame .eyebrow { color: #188038; font-weight: 500; }
  .search-frame .hero-h1 { color: #1a0dab; }
  /* The dark-hero gold shimmer does not read on white; the accent is a solid gold mark instead. */
  .search-frame :global(.word-rise .accent) {
    background: linear-gradient(transparent 62%, rgba(201, 162, 39, .45) 62%);
    -webkit-background-clip: border-box; background-clip: border-box;
    color: inherit; animation: none; padding: 0 .06em; margin: 0 -.06em;
  }
  @media (max-width: 640px) {
    .search-top { padding: 14px 14px 0; }
    .search-result { padding: 16px 18px 22px; }
    .search-tabs span:last-child { display: none; }
  }

  .service-card {
    border-radius: 22px; padding: 26px 28px 14px;
    background: linear-gradient(180deg, #fff, var(--color-cream-50));
    border: 1px solid rgba(255, 255, 255, .7);
    box-shadow: 0 30px 60px -36px rgba(0, 0, 0, .75), 0 1px 0 rgba(255, 255, 255, .9) inset;
  }

  /* The booking card: glass panel with a gold hairline, so the calendar reads as the main action. */
  .book-card {
    position: relative; border-radius: 28px; padding: 28px;
    background: linear-gradient(180deg, rgba(255, 255, 255, .09), rgba(255, 255, 255, .03));
    border: 1px solid rgba(230, 205, 131, .38);
    box-shadow: 0 50px 90px -45px rgba(0, 0, 0, .85), 0 0 70px -30px rgba(201, 162, 39, .35), 0 1px 0 rgba(255, 255, 255, .12) inset;
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    transition: border-color 300ms, box-shadow 300ms;
  }
  .book-card.is-flash {
    border-color: var(--color-gold-500);
    box-shadow: 0 50px 90px -45px rgba(0, 0, 0, .85), 0 0 0 4px rgba(201, 162, 39, .55), 0 0 90px -20px rgba(201, 162, 39, .7);
  }
  .book-card :global(.frame) { border-radius: 18px; box-shadow: 0 20px 40px -24px rgba(0, 0, 0, .6); }
  @media (max-width: 640px) { .book-card { padding: 20px; border-radius: 24px; } }

  .contact-pill {
    display: flex; align-items: center; gap: 12px; padding: 12px 18px; border-radius: 16px;
    font-size: 18px; font-weight: 600; letter-spacing: -0.01em; line-height: 1.2; color: #fff;
    background: rgba(255, 255, 255, .06); border: 1px solid rgba(255, 255, 255, .12);
    transition: background-color 200ms, border-color 200ms;
  }
  .contact-pill:hover { background: rgba(255, 255, 255, .1); border-color: rgba(230, 205, 131, .5); }
</style>
