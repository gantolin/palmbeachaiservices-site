---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/ui/Icon.astro';
import BookingEmbed from '@/components/islands/BookingEmbed.astro';
import { SITE, FOUNDER_FIRST_NAME, telHref } from '@/config/site';
import { words } from '@/lib/text';
import { serviceGroups as groups } from '@/data/offer';

const headline = 'Get found on Google. Get *hours back* every week.';

---
<Base
  title="Local SEO & AI for Home Service Businesses | Palm Beach AI Services"
  description={`Get found on Google and get hours back with AI. Websites, Google Business Profile, reviews, call answering, and lead follow-up for plumbers, electricians, HVAC, roofers, painters, cleaners, and other home service businesses in Palm Beach County.`}
>
  <section class="relative overflow-hidden surface-dark grain -mt-px" id="services">
    <div class="hero-bloom absolute inset-0 glow-navy" aria-hidden="true"></div>
    <div class="container-x relative pt-10 pb-16 sm:pt-14 sm:pb-20">
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-12 lg:items-start">
        <div>
          <div class="eyebrow fade-in">For home service businesses in Palm Beach County</div>
          <h1 class="h1 hero-h1 mt-5 text-[#f4f1e8] word-rise" set:html={words(headline)} />
          <p class="mt-5 text-[17px] leading-relaxed text-mist-400 max-w-[46ch] fade-in" style="--d:250ms">For plumbers, electricians, HVAC, roofers, painters, cleaners, landscapers, and every other home service business.</p>

          <div class="mt-7 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6 fade-in lg:hidden" style="--d:300ms">
            <a href="#book" class="btn btn-primary btn-lg btn-shine">Book a free call<Icon name="arrow-right" size={18} /></a>
            <a href={telHref} class="inline-flex items-center gap-2 text-[16px] font-semibold text-mist-200 hover:text-white self-start sm:self-auto"><Icon name="phone" size={17} />or call {SITE.phone}</a>
          </div>

          <div class="mt-9 grid gap-5 fade-in" style="--d:300ms">
            {groups.map((g) => (
              <div class="rounded-[20px] bg-cream-50 p-6 sm:p-7">
                <h2 class="h3 text-ink-900">{g.title}</h2>
                <ul class="mt-4 space-y-3">
                  {g.items.map((s) => (
                    <li class="flex gap-3">
                      <Icon name="check" size={19} stroke={2.6} class="mt-[3px] shrink-0 text-navy-700" />
                      <p class="text-[16px] leading-snug text-ink-600"><span class="font-semibold text-ink-900">{s.name}.</span> {s.text}</p>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>

        <div id="book" class="scroll-mt-28 fade-in lg:sticky lg:top-28" style="--d:200ms">
          <h2 class="h3 text-[#f4f1e8]">Book a free 30-minute call.</h2>
          <p class="mt-3 text-[16px] leading-relaxed text-mist-400">Pick a time. {FOUNDER_FIRST_NAME} looks at your website and your Google profile before the call and tells you what to fix first. No contract, and nothing to sign.</p>
          <div class="mt-6">
            <BookingEmbed title="Book a free 30-minute call" compact />
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  @media (min-width: 1024px) { .hero-h1 { font-size: clamp(2.4rem, 3.4vw, 3.1rem); } }
</style>