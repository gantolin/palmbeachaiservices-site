---
import Base from '@/layouts/Base.astro';
import HomeHero from '@/components/sections/HomeHero.astro';
import ProofStrip from '@/components/sections/ProofStrip.astro';
import Problem from '@/components/sections/Problem.astro';
import ThreeThings from '@/components/sections/ThreeThings.astro';
import HowItWorks from '@/components/sections/HowItWorks.astro';
import CaseStudies from '@/components/sections/CaseStudies.astro';
import Comparison from '@/components/sections/Comparison.astro';
import PricingPlan from '@/components/sections/PricingPlan.astro';
import Guarantee from '@/components/sections/Guarantee.astro';
import Testimonials from '@/components/sections/Testimonials.astro';
import Founder from '@/components/sections/Founder.astro';
import FAQ from '@/components/sections/FAQ.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';
import Icon from '@/components/ui/Icon.astro';
import Marquee from '@/components/ui/Marquee.astro';
import { SITE } from '@/config/site';
const serviceTicker = ['Custom websites', 'Google Business Profile', 'Local SEO', 'Review automation', 'Missed-call text-back', 'Lead follow-up', 'Custom AI tools'];
import { homeFaqs } from '@/data/faq';
---
<Base
  title="Local SEO & AI for Home Service Businesses | Palm Beach AI Services"
  description={`Get seen on Google. Get your time back with AI. Local SEO, Google Maps, and AI automation for home service businesses in Royal Palm Beach and Palm Beach County. No contract, and you own everything.`}
  faqs={homeFaqs}
>
  <HomeHero />
  <div class="ticker-band surface-dark border-b border-white/[0.06]">
    <Marquee items={serviceTicker} label="What we do" size="lg" duration={42} />
    <Marquee items={SITE.serviceAreas} label="Towns we serve in Palm Beach County" duration={56} reverse />
  </div>
  <ProofStrip />
  <Problem />
  <ThreeThings />
  <HowItWorks />
  <section class="section surface-cream" id="whats-included">
    <div class="container-x">
      <div class="mx-auto max-w-3xl text-center" data-reveal>
        <div class="eyebrow justify-center">What you get</div>
        <h2 class="h2 mt-5">One plan. <em class="accent">Everything</em> included.</h2>
        <p class="lede mt-6 mx-auto">A one-time website build, then one flat monthly plan for everything that keeps the phone ringing. No tiers, no contract, and a fixed quote in writing before we start.</p>
      </div>
      <div class="mt-12">
        <PricingPlan showPromises={false} />
      </div>
    </div>
  </section>

  <CaseStudies flush eyebrow="The proof behind the plan" title="What that work looks like for *real* local businesses." lede="Exact numbers, with the math shown. No stock logos, no made-up stats." />
  <Comparison />

  <Guarantee />
  <Testimonials />
  <Founder />
  <FAQ faqs={homeFaqs} title="Straight *answers.*" />
  <FinalCTA />
</Base>
