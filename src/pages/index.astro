---
import Base from '@/layouts/Base.astro';
import HomeHero from '@/components/sections/HomeHero.astro';
import CaseStudies from '@/components/sections/CaseStudies.astro';
import Founder from '@/components/sections/Founder.astro';
import FAQ from '@/components/sections/FAQ.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';
import Icon from '@/components/ui/Icon.astro';
import PhoneDemo from '@/components/islands/PhoneDemo.astro';
import { homeFaqs } from '@/data/faq';
import { CTA, FOUNDER_FIRST_NAME } from '@/config/site';

// Each service starts from the problem the owner already has.
const services = [
  {
    pain: 'People search for your trade and find someone else.',
    name: 'Website SEO',
    text: 'We build or fix your website so it shows up on Google for the services you offer in the towns you work in.',
    href: '/services/websites/',
  },
  {
    pain: 'You do not show up on Google Maps.',
    name: 'Google Business Profile',
    text: 'We set up and manage your Google Business Profile: categories, services, photos, posts, and reviews.',
    href: '/services/google-maps-seo/',
  },
  {
    pain: 'Reports eat your evenings.',
    name: 'Faster reports',
    text: 'We build an AI tool that drafts your reports for you. One client went from 45 minutes per report to 10.',
    href: '/results/mold-inspection-company/',
  },
  {
    pain: 'Too much of your week goes to office work.',
    name: 'AI for the rest of the business',
    text: 'Estimates, invoices, reminders, and follow-up. We find where the hours go and set up AI to handle what it can.',
    href: '/services/ai-automation/',
  },
];

// Shown beside the phone demo.
const answers = [
  { name: 'Missed-call text back', text: 'A missed call gets a text within seconds, so the customer hears from you before they call the next company.', href: '/services/ai-automation/' },
  { name: 'AI phone receptionist', text: 'Answers after hours and when you are on a job, takes the details, and books the visit.', href: '/services/ai-answering-service/' },
  { name: 'Lead follow-up', text: 'New leads and open quotes get a text or an email on schedule until they book or say no.', href: '/services/ai-automation/' },
];

const audits = [
  {
    name: 'Free website and Google Business Profile audit',
    text: `${FOUNDER_FIRST_NAME} goes through your website and your Google profile next to the companies showing up above you, and tells you what to fix first.`,
    cta: CTA.secondary.label,
    href: CTA.secondary.href,
  },
  {
    name: 'Free AI audit',
    text: `${FOUNDER_FIRST_NAME} looks at how your week runs, where the time goes, and which of that work AI can take over. You get a short list, starting with the biggest time saver.`,
    cta: 'Book my free AI audit',
    href: CTA.primary.href,
  },
];
---
<Base
  title="Local SEO & AI for Home Service Businesses | Palm Beach AI Services"
  description={`Get found on Google and get hours back with AI. Website SEO, Google Business Profile, faster reports, and AI audits for home service businesses in Royal Palm Beach and Palm Beach County.`}
  faqs={homeFaqs}
>
  <HomeHero />

  <section class="section surface-cream" id="services">
    <div class="container-x">
      <div class="max-w-3xl" data-reveal>
        <div class="eyebrow">What we do</div>
        <h2 class="h2 mt-5">Four services, each one for a problem you already have.</h2>
      </div>
      <div class="mt-12 grid gap-5 md:grid-cols-2">
        {services.map((s, i) => (
          <a href={s.href} class="card lift group flex flex-col p-7 sm:p-8 rounded-[20px]" data-reveal style={`--d:${i * 70}ms`}>
            <p class="text-[15px] text-ink-600">{s.pain}</p>
            <h3 class="h3 mt-3">{s.name}</h3>
            <p class="mt-3 text-[16px] text-ink-900/90">{s.text}</p>
            <span class="mt-auto pt-6 inline-flex items-center gap-2 text-[14.5px] font-semibold text-navy-700">Learn more <Icon name="arrow-right" size={16} class="transition-transform group-hover:translate-x-1" /></span>
          </a>
        ))}
      </div>
      <p class="mt-8 text-[16px] text-ink-600" data-reveal>We also run Facebook ads, Google review requests, lead follow-up, and a lead dashboard. <a href="/services/" class="font-semibold text-navy-700 underline underline-offset-4">See all services</a></p>
    </div>
  </section>

  <section class="section surface-dark relative overflow-hidden grain" id="leads">
    <div class="container-x relative">
      <div class="grid items-center gap-14 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-7" data-reveal>
          <div class="eyebrow">When you can't pick up</div>
          <h2 class="h2 mt-5 text-[#f4f1e8]">The lead still gets an answer.</h2>
          <ul class="mt-9 space-y-7 max-w-[56ch]">
            {answers.map((a) => (
              <li>
                <a href={a.href} class="group block">
                  <h3 class="h3 text-[#f4f1e8] inline-flex items-center gap-2.5">{a.name}<Icon name="arrow-right" size={17} class="text-gold-300 transition-transform group-hover:translate-x-1" /></h3>
                  <p class="mt-2 text-mist-400 text-[16px] leading-relaxed">{a.text}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class="lg:col-span-5" data-reveal style="--d:100ms">
          <PhoneDemo />
        </div>
      </div>
    </div>
  </section>

  <section class="section surface-sand" id="audits">
    <div class="container-x">
      <div class="max-w-3xl" data-reveal>
        <div class="eyebrow">Where to start</div>
        <h2 class="h2 mt-5">Start with a free audit.</h2>
        <p class="lede mt-6">Before you spend anything, find out what is worth fixing. Both audits are free, and you keep what you learn whether or not we work together.</p>
      </div>
      <div class="mt-12 grid gap-5 md:grid-cols-2">
        {audits.map((a, i) => (
          <div class="card flex flex-col p-7 sm:p-8 rounded-[20px]" data-reveal style={`--d:${i * 70}ms`}>
            <h3 class="h3">{a.name}</h3>
            <p class="mt-3 text-[16px] text-ink-900/90">{a.text}</p>
            <div class="mt-auto pt-7"><a href={a.href} class="btn btn-navy">{a.cta}<Icon name="arrow-right" size={17} /></a></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CaseStudies eyebrow="Recent work" title="A few businesses we have helped." lede="Real clients and real numbers. Click any of them for the full story." />

  <Founder />
  <FAQ faqs={homeFaqs} title="Common *questions.*" />
  <FinalCTA />
</Base>
