---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/sections/PageHero.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';
import Icon from '@/components/ui/Icon.astro';
import { SITE } from '@/config/site';
import { trades } from '@/data/offer';
const values = [
  { icon: 'receipt', title: 'Your price in writing', text: 'You should know exactly what something costs before any work starts. So every quote is fixed and in writing, with no surprise invoices later.' },
  { icon: 'key', title: 'You own everything', text: 'Your domain, your website, your Google profile, your customer list. If you ever leave, it all goes with you.' },
  { icon: 'handshake', title: 'Month-to-month', text: 'There is no long contract. If it stops paying off, you can stop.' },
  { icon: 'users', title: 'Local, in person', text: 'We meet owners at their business anywhere in Palm Beach County, so you know who you are working with.' },
  { icon: 'zap', title: 'Less busywork', text: 'We automate the repetitive stuff, like follow-up texts and review requests, so it gets done without you.' },
  { icon: 'chart', title: 'Straightforward reports', text: 'Once a month you see your calls, reviews, and rankings, and we talk through what they mean.' },
];
---
<Base
  title={`About ${SITE.name} | Local SEO and AI in Royal Palm Beach, FL`}
  description={`${SITE.name} is a local SEO and AI company in Royal Palm Beach, serving contractors, restaurants, medical offices, and other local businesses across Palm Beach County.`}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'About', url: '/about/' }]}
>
  <PageHero compact eyebrow="About" title="Local, and built for local business owners."
    lede={`${SITE.name} helps contractors, restaurants, medical offices, and other local businesses in Palm Beach County get found on Google and get hours back with AI. We do the work ourselves, so the people you talk to are the people building it.`} />
  <section class="section surface-cream">
    <div class="container-x">
      <div class="max-w-2xl" data-reveal>
        <div class="eyebrow">How we work</div>
        <h2 class="h2 mt-5">The rules we run on.</h2>
      </div>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {values.map((v, i) => (
          <div class="card p-7 rounded-[20px]" data-reveal style={`--d:${(i % 3) * 80}ms`}>
            <span class="size-11 rounded-xl bg-navy-100 text-navy-700 flex items-center justify-center"><Icon name={v.icon} size={20} /></span>
            <h3 class="mt-5 font-display text-[20px] font-[600] tracking-tight">{v.title}</h3>
            <p class="mt-2 text-ink-600 text-[15.5px]">{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="section surface-sand">
    <div class="container-x grid gap-12 lg:grid-cols-2">
      <div data-reveal>
        <div class="eyebrow">Who we help</div>
        <h2 class="h2 mt-5">Local businesses.</h2>
        <p class="lede mt-6">If customers find you on Google and then call or book, we can help you get more of them.</p>
        <ul class="mt-8 flex flex-wrap gap-2">{trades.map((i) => <li class="chip bg-white border border-stone-300 text-[14px]">{i}</li>)}</ul>
      </div>
      <div data-reveal style="--d:100ms">
        <div class="eyebrow">Where we work</div>
        <h2 class="h2 mt-5">Home base: {SITE.homeBase}.</h2>
        <p class="lede mt-6">We serve all of {SITE.primaryArea}, plus {SITE.nearbyCounties.join(' and ')}. Local means we can meet in person.</p>
        <ul class="mt-8 grid grid-cols-2 gap-x-6 gap-y-2.5 text-[15.5px]">
          {SITE.serviceAreas.map((a, i) => <li class="flex items-center gap-2.5"><Icon name="pin" size={16} class={i === 0 ? 'text-gold-700' : 'text-navy-700'} /><span class={i === 0 ? 'font-semibold' : ''}>{a}</span></li>)}
        </ul>
      </div>
    </div>
  </section>
  <FinalCTA />
</Base>
