---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/sections/PageHero.astro';
import Trades from '@/components/sections/Trades.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';
import Icon from '@/components/ui/Icon.astro';
import { serviceGroups } from '@/data/offer';
---
<Base
  title="Services for Home Service Businesses | Palm Beach AI Services"
  description="Websites, Google Business Profile, Google reviews, call answering, lead follow-up, and AI paperwork for plumbers, electricians, HVAC, roofers, painters, cleaners, and other home service businesses in Palm Beach County."
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Services', url: '/services/' }]}
>
  <PageHero compact eyebrow="Services" title="What we do for home service businesses."
    lede="Two things: get you found on Google, and get you hours back with AI." />

  <section class="surface-cream py-12 sm:py-16">
    <div class="container-x space-y-14">
      {serviceGroups.map((g) => (
        <div>
          <h2 class="h2 text-ink-900">{g.title}</h2>
          <p class="mt-3 text-[17px] text-ink-600">{g.intro}</p>
          <div class:list={['mt-7 grid gap-5 sm:grid-cols-2', g.items.length === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3']}>
            {g.items.map((s) => (
              <div class="card rounded-[20px] p-7">
                <span class="size-11 rounded-xl bg-navy-700 text-gold-300 flex items-center justify-center"><Icon name={s.icon} size={20} /></span>
                <h3 class="mt-5 font-display text-[21px] font-[600] tracking-tight text-ink-900">{s.name}</h3>
                <p class="mt-2 text-[16px] leading-snug text-ink-900/90">{s.text}</p>
                <p class="mt-3 text-[15px] leading-relaxed text-ink-600">{s.detail}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <Trades />
  <FinalCTA />
</Base>
