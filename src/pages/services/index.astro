---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/sections/PageHero.astro';
import Trades from '@/components/sections/Trades.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';
import Icon from '@/components/ui/Icon.astro';
import { serviceGroups } from '@/data/offer';
---
<Base
  title="Local SEO, Google Business Profile & AI Automation Services"
  description="Websites, Google Business Profile, Google reviews, call answering, lead follow-up, and AI paperwork for local businesses in Palm Beach County."
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Services', url: '/services/' }]}
>
  <PageHero compact eyebrow="Services" title="What we do for local businesses."
    lede="Two things: get you found on Google, and get you hours back with AI." />

  <section class="surface-cream py-12 sm:py-16">
    <div class="container-x space-y-14">
      {serviceGroups.map((g) => (
        <div>
          <h2 class="h2 text-ink-900">{g.title}</h2>
          <p class="mt-3 text-[17px] text-ink-600">{g.intro}</p>
          <div class:list={['mt-7 grid gap-5 sm:grid-cols-2', g.items.length === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3']}>
            {g.items.map((s) => (
              <div class="svc card rounded-[20px] p-7">
                <span class="svc-icon size-11 rounded-xl bg-navy-700 text-gold-300 flex items-center justify-center"><Icon name={s.icon} size={20} /></span>
                <h3 class="mt-5 font-display text-[21px] font-[600] tracking-tight text-ink-900">{s.name}</h3>
                <p class="mt-2 text-[16px] leading-snug text-ink-900/90">{s.text}</p>
                <p class="mt-3 text-[15px] leading-relaxed text-ink-600">{s.detail}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <Trades />
  <FinalCTA />
</Base>

<style>
  /* On a computer each service card answers the mouse: it lifts, a gold edge grows up its left side,
     and the icon flips to gold. Phones have no hover, so nothing changes there. */
  .svc { position: relative; overflow: hidden; transition: transform 280ms cubic-bezier(.22, 1, .36, 1), box-shadow 280ms, border-color 280ms; }
  .svc::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--color-gold-500); transform: scaleY(0); transform-origin: 50% 100%; transition: transform 320ms cubic-bezier(.22, 1, .36, 1); }
  .svc-icon { transition: background-color 250ms, color 250ms, transform 320ms cubic-bezier(.22, 1, .36, 1); }
  @media (hover: hover) {
    .svc:hover { transform: translateY(-5px); border-color: rgba(201, 162, 39, .6); box-shadow: 0 1px 2px rgba(3, 14, 29, .05), 0 28px 50px -22px rgba(3, 14, 29, .35); }
    .svc:hover::before { transform: scaleY(1); }
    .svc:hover .svc-icon { background: var(--color-gold-500); color: var(--color-navy-950); transform: scale(1.08) rotate(-5deg); }
  }
</style>
