---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/sections/PageHero.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';
import Icon from '@/components/ui/Icon.astro';
import { SITE } from '@/config/site';

const guides = (await getCollection('guides')).sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime());
const pillars = ['Get seen on Google', 'Get your time back with AI'] as const;
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Guides', url: '/guides/' }];
---
<Base
  title="Guides: Get Seen on Google & Save Time with AI | Palm Beach AI Services"
  description="Plain-English guides for home service businesses: rank higher on Google Maps, get more Google reviews, local SEO for contractors, speed to lead, and SEO costs."
  breadcrumbs={crumbs}
>
  <PageHero eyebrow="Guides" title="How to get *seen* on Google, and get your time back." lede={`Free, plain-English playbooks for home service owners, written by ${SITE.founder} in ${SITE.homeBase}. No fluff, no jargon, no email required.`} crumbs={crumbs} />
  {pillars.map((p, pi) => {
    const list = guides.filter((g) => g.data.pillar === p);
    return list.length > 0 && (
      <section class:list={['section', pi % 2 ? 'surface-sand' : 'surface-cream']}>
        <div class="container-x">
          <div class="eyebrow">{p}</div>
          <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {list.map((g, i) => (
              <a href={`/guides/${g.id}/`} class="card lift group p-8 rounded-[20px] flex flex-col" data-reveal style={`--d:${i * 70}ms`}>
                <h2 class="font-display text-[21px] font-[600] tracking-tight leading-snug">{g.data.title}</h2>
                <p class="mt-3 text-ink-600 text-[15px]">{g.data.description}</p>
                <span class="mt-auto pt-6 inline-flex items-center gap-2 text-[14.5px] font-semibold text-navy-700">Read the guide <Icon name="arrow-right" size={16} class="transition-transform group-hover:translate-x-1" /></span>
              </a>
            ))}
          </div>
        </div>
      </section>
    );
  })}
  <FinalCTA />
</Base>
