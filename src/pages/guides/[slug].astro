---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/sections/PageHero.astro';
import FAQ from '@/components/sections/FAQ.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';
import Icon from '@/components/ui/Icon.astro';
import { SITE, CTA } from '@/config/site';
import { getService } from '@/data/services';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((g) => ({ params: { slug: g.id }, props: { guide: g } }));
}
const { guide } = Astro.props as { guide: CollectionEntry<'guides'> };
const { Content, headings } = await render(guide);
const d = guide.data;
const path = `/guides/${guide.id}/`;
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Guides', url: '/guides/' }, { name: d.title, url: path }];
const service = getService(d.relatedService)!;
const toc = headings.filter((h) => h.depth === 2);
const words = (guide.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(3, Math.round(words / 230));
const fmt = (dt: Date) => dt.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const others = (await getCollection('guides')).filter((g) => g.id !== guide.id).slice(0, 3);

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  url: `${SITE.url}${path}`,
  mainEntityOfPage: `${SITE.url}${path}`,
  datePublished: d.published.toISOString().slice(0, 10),
  dateModified: d.updated.toISOString().slice(0, 10),
  author: { '@type': 'Person', name: SITE.founder, worksFor: { '@id': `${SITE.url}/#business` } },
  publisher: { '@id': `${SITE.url}/#business` },
  image: `${SITE.url}${SITE.ogImage}`,
  about: d.keyword,
};
---
<Base title={d.metaTitle} description={d.description} faqs={d.faqs} breadcrumbs={crumbs} schema={[articleLd]} type="article">
  <PageHero eyebrow={`Guide · ${d.pillar}`} title={d.title} lede={d.lede} crumbs={crumbs}>
    <p class="mt-7 font-mono text-[12px] uppercase tracking-[0.1em] text-mist-400 fade-in" style="--d:400ms">
      By {SITE.founder}, {SITE.name} · Updated <time datetime={d.updated.toISOString().slice(0, 10)}>{fmt(d.updated)}</time> · {minutes} min read
    </p>
  </PageHero>

  <section class="section surface-cream !pt-14">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <aside class="lg:col-span-3 lg:order-2">
        <div class="lg:sticky lg:top-32 space-y-5">
          {toc.length > 2 && (
            <nav aria-label="In this guide" class="card p-6 rounded-[18px]">
              <div class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-600">In this guide</div>
              <ol class="mt-3 space-y-2 text-[14.5px]">
                {toc.map((h) => <li><a href={`#${h.slug}`} class="text-navy-700 hover:underline">{h.text}</a></li>)}
              </ol>
            </nav>
          )}
          <a href={`/services/${service.slug}/`} class="card lift group block p-6 rounded-[18px]">
            <span class="size-10 rounded-xl bg-navy-700 text-gold-300 flex items-center justify-center"><Icon name={service.icon} size={19} /></span>
            <div class="mt-4 font-mono text-[11px] uppercase tracking-[0.1em] text-navy-700">Want it done for you?</div>
            <div class="mt-1 font-display text-[18px] font-[600] tracking-tight">{service.name}</div>
            <span class="mt-3 inline-flex items-center gap-2 text-[14px] font-semibold text-navy-700">See how it works <Icon name="arrow-right" size={15} class="transition-transform group-hover:translate-x-1" /></span>
          </a>
          <a href={CTA.primary.href} class="btn btn-primary w-full">{CTA.primary.label}<Icon name="arrow-right" size={16} /></a>
        </div>
      </aside>
      <article class="lg:col-span-9 lg:order-1 prose-guide">
        <Content />
      </article>
    </div>
  </section>

  {d.faqs.length > 0 && <FAQ faqs={d.faqs} title="Quick *answers*" surface="surface-sand" />}

  {others.length > 0 && (
    <section class="section surface-cream">
      <div class="container-x">
        <div class="eyebrow">Keep reading</div>
        <div class="mt-8 grid gap-5 md:grid-cols-3">
          {others.map((g) => (
            <a href={`/guides/${g.id}/`} class="card lift group p-7 rounded-[20px] flex flex-col">
              <div class="font-mono text-[11px] uppercase tracking-[0.1em] text-navy-700">{g.data.pillar}</div>
              <h2 class="mt-2 font-display text-[19px] font-[600] tracking-tight leading-snug">{g.data.title}</h2>
              <span class="mt-auto pt-5 inline-flex items-center gap-2 text-[14px] font-semibold text-navy-700">Read the guide <Icon name="arrow-right" size={15} class="transition-transform group-hover:translate-x-1" /></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
  <FinalCTA />
</Base>
