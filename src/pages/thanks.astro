---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/ui/Icon.astro';
import BookingEmbed from '@/components/islands/BookingEmbed.astro';
import { FOUNDER_FIRST_NAME } from '@/config/site';
---
<Base title="Thanks! Your Google Check Is on the Way | Palm Beach AI Services" description="Thanks for reaching out to Palm Beach AI Services. Your free Google Visibility Check walkthrough arrives within two business days." noindex>
  <section class="relative overflow-hidden surface-dark grain -mt-px min-h-[70vh]">
    <div class="hero-bloom absolute inset-0 glow-navy" aria-hidden="true"></div>
    <div class="container-x relative py-20 sm:py-24">
      <div class="max-w-3xl mx-auto text-center">
        <span class="mx-auto size-14 rounded-2xl bg-gold-500 text-navy-950 flex items-center justify-center"><Icon name="check" size={28} stroke={2.4} /></span>
        <h1 class="h1 mt-6 text-[#f4f1e8]">Got it. Your walkthrough is on the way.</h1>
        <p class="lede mt-5 mx-auto">{FOUNDER_FIRST_NAME} will record a walkthrough of your Google profile and website and email it to you within two business days. If you would like to go over it together, pick a time below.</p>
        <div class="mt-10 text-left">
          <BookingEmbed />
        </div>
      </div>
    </div>
  </section>
</Base>
