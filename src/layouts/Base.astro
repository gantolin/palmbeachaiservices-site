---
import '@/styles/global.css';
import SEO from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import MobileBar from '@/components/MobileBar.astro';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  faqs?: { q: string; a: string }[];
  breadcrumbs?: { name: string; url: string }[];
  /** Extra JSON-LD objects for this page (Service, Article, ...). */
  schema?: Record<string, unknown>[];
  type?: 'website' | 'article';
}
const props = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!--
      GitHub Pages cannot send response headers, so the security policy lives here.
      The only third parties are Web3Forms (form POST), Calendly (booking iframe) and Google Maps (contact page iframe).
      Add a host here before loading anything new (analytics, pixels, embeds), or it will be blocked.
      frame-ancestors is ignored in a meta tag; that needs a header (Cloudflare) if clickjacking ever matters.
    -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://api.web3forms.com; frame-src https://calendly.com https://www.google.com; form-action 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>document.documentElement.classList.add('js');setTimeout(function(){if(!window.__motion)document.documentElement.classList.add('motion-failsafe')},2500)</script>
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#07182F" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO {...props} />
  </head>
  <body class="min-h-dvh flex flex-col">
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <MobileBar />

    <script>
      import '@/scripts/motion';
      import '@/scripts/contact-links';
    </script>

    <style is:global>
      .contact-note {
        position: fixed; left: 50%; bottom: 28px; z-index: 60; transform: translate(-50%, 12px);
        max-width: calc(100vw - 32px); padding: 14px 22px; border-radius: 999px;
        background: var(--color-navy-950); color: #fff; border: 1px solid var(--color-gold-500);
        font: 600 16px/1.3 var(--font-sans); box-shadow: 0 14px 40px -12px rgba(0, 0, 0, .6);
        opacity: 0; pointer-events: none; transition: opacity 200ms, transform 200ms;
      }
      .contact-note[data-show='true'] { opacity: 1; transform: translate(-50%, 0); }
    </style>
  </body>
</html>
